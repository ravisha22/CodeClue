# External repo clones (large, re-cloneable)
experiments/external-repos/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environment
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Byte-compiled
*.pyc

# Temp and generated
*.tmp
.pytest_cache/
.mypy_cache/

# Large experiment artifacts (re-generable from source)
experiments/runs/*/graph.json
experiments/runs/*/graph-tier2.json
