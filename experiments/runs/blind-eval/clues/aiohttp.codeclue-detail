{"symbol":"test_cancelled_waiter","type":"async_function","file":"tests/test_connector.py","lines":[3836,3856],"source":"async def test_cancelled_waiter(loop: asyncio.AbstractEventLoop) -> None:\n    conn = aiohttp.BaseConnector(limit=1)\n    req = mock.Mock()\n    req.connection_key = \"key\"\n    proto = create_mocked_conn(loop)\n\n    async def create_connection(req: object, traces: object = None) -> ResponseHandler:\n        await asyncio.sleep(1)\n        return proto\n\n    with mock.patch.object(conn, \"_create_connection\", create_connection):\n        conn._acquired.add(proto)\n\n        conn2 = loop.create_task(conn.connect(req, [], ClientTimeout()))\n        await asyncio.sleep(0)\n        conn2.cancel()\n\n        with pytest.raises(asyncio.CancelledError):\n            await conn2\n\n    await conn.close()","calls":["create_mocked_conn"],"called_by":[],"confidence":0.92,"purpose":"async_function test_cancelled_waiter"}
