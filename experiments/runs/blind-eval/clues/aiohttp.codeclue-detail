{"symbol":"test_readline_error_on_conn_close","type":"async_function","file":"tests/test_client_functional.py","lines":[1291,1324],"source":"async def test_readline_error_on_conn_close(aiohttp_client: AiohttpClient) -> None:\n    loop = asyncio.get_event_loop()\n\n    async def handler(request: web.Request) -> NoReturn:\n        resp = web.StreamResponse()\n        await resp.prepare(request)\n\n        # make sure connection is closed by client.\n        with pytest.raises(aiohttp.ServerDisconnectedError):\n            for _ in range(10):\n                await resp.write(b\"data\\n\")\n                await asyncio.sleep(0.5)\n        assert False\n\n    app = web.Application()\n    app.router.add_route(\"GET\", \"/\", handler)\n    server = await aiohttp_client(app)\n\n    async with aiohttp.ClientSession() as session:\n        timer_started = False\n        url, headers = server.make_url(\"/\"), {\"Connection\": \"Keep-alive\"}\n        resp = await session.get(url, headers=headers)\n        with pytest.raises(aiohttp.ClientConnectionError):\n            while True:\n                data = await resp.content.readline()\n                data = data.strip()\n                assert data\n                assert data == b\"data\"\n                if not timer_started:\n                    loop.call_later(1.0, resp.release)\n                    timer_started = True\n\n\nasync def test_no_error_on_conn_close_if_eof(aiohttp_client: AiohttpClient) -> None:","calls":[],"called_by":[],"confidence":0.92,"purpose":"async_function test_readline_error_on_conn_close"}
