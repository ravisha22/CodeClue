{"symbol":"get_memory_usage","type":"function","file":"tests/test_streams.py","lines":[50,72],"source":"def get_memory_usage(obj: object) -> int:\n    objs = [obj]\n    # Memory leak may be caused by leaked links to same objects.\n    # Without link counting, [1,2,3] is indistinguishable from [1,2,3,3,3,3,3,3]\n    known: defaultdict[int, int] = defaultdict(int)\n    known[id(obj)] += 1\n\n    while objs:\n        refs = gc.get_referents(*objs)\n        objs = []\n        for obj in refs:\n            if isinstance(obj, MEMLEAK_SKIP_TYPES):\n                continue\n            i = id(obj)\n            known[i] += 1\n            if known[i] == 1:\n                objs.append(obj)\n\n        # Make list of unhashable objects uniq\n        objs.sort(key=id)\n        objs = [next(g) for (i, g) in groupby(objs, id)]\n\n    return sum(known.values())","calls":[],"called_by":["test_chunksplits_memory_leak","test_chunksplits_memory_leak","TestStreamReader","TestStreamReader"],"confidence":0.92,"purpose":"function get_memory_usage"}
