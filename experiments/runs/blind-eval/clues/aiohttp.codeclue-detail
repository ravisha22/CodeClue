{"symbol":"gen_ws_headers","type":"function","file":"tests/test_websocket_handshake.py","lines":[12,39],"source":"def gen_ws_headers(\n    protocols: str = \"\",\n    compress: int = 0,\n    extension_text: str = \"\",\n    server_notakeover: bool = False,\n    client_notakeover: bool = False,\n) -> tuple[list[tuple[str, str]], str]:\n    key = base64.b64encode(os.urandom(16)).decode()\n    hdrs = [\n        (\"Upgrade\", \"websocket\"),\n        (\"Connection\", \"upgrade\"),\n        (\"Sec-Websocket-Version\", \"13\"),\n        (\"Sec-Websocket-Key\", key),\n    ]\n    if protocols:\n        hdrs += [(\"Sec-Websocket-Protocol\", protocols)]\n    if compress:\n        params = \"permessage-deflate\"\n        if compress < 15:\n            params += \"; server_max_window_bits=\" + str(compress)\n        if server_notakeover:\n            params += \"; server_no_context_takeover\"\n        if client_notakeover:\n            params += \"; client_no_context_takeover\"\n        if extension_text:\n            params += \"; \" + extension_text\n        hdrs += [(\"Sec-Websocket-Extensions\", params)]\n    return hdrs, key","calls":[],"called_by":["test_handshake_compress","test_handshake_compress_bad_ext","test_handshake_compress_client_notakeover","test_handshake_compress_multi_ext_bad","test_handshake_compress_multi_ext_wbits","test_handshake_compress_server_notakeover","test_handshake_compress_wbits","test_handshake_compress_wbits_error","test_handshake_no_transfer_encoding","test_handshake_ok","test_handshake_protocol","test_handshake_protocol_agreement","test_handshake_protocol_unsupported"],"confidence":0.92,"purpose":"function gen_ws_headers"}
