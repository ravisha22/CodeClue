\n\n    if args.path and args.hostname is None:\n        host = port = None\n    else:\n        host = args.hostname or \"localhost\"\n        port = args.port\n\n    app = func(extra_argv)\n    run_app(app, host=host, port=port, path=args.path)\n    arg_parser.exit(message=\"Stopped\\n\")","calls":["run_app"],"called_by":[],"confidence":0.92,"purpose":"function main"}
