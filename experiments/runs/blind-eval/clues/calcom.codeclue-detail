t team installation always. */\n  concurrentMeetings?: boolean;\n\n  createdAt?: string;\n  /** Specifies if the App uses an OAuth flow  */\n  isOAuth?: boolean;\n  /**\n   * Specifies if the App supports delegation credential\n   */\n  delegationCredential?: {\n    workspacePlatformSlug: string;\n  };\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "interface App", "behavior_patterns": [], "semantic_contract": {"purpose": "interface App", "language": "typescript", "symbol_name": "App", "symbol_type": "interface", "signature": "", "behavior_patterns": [], "tier": 1, "calls": [], "uses": ["package.json", "app.gitbook.com", "Cal.diy", "Prisma.JsonValue"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
