ToProcess.map(processDelegationUserCredential)\n    );\n    const successCount = results.filter((r) => r.status === \"fulfilled\").length;\n    const failureCount = results.filter((r) => r.status === \"rejected\").length;\n    log.info(\n      `Processed ${successCount} selected calendars for delegationCredentialId: ${delegationCredentialId} and ${failureCount} failures`\n    );\n    totalSuccess += successCount;\n    totalFailures += failureCount;\n  }\n\n  log.info(\n    `Completed creating selected calendars for all delegation credentials. Total Success: ${totalSuccess}, Total Failures: ${totalFailures}`\n  );\n\n  return {\n    message: \"All selected calendars created\",\n    executedAt: new Date().toISOString(),\n    success: totalSuccess,\n    failures: totalFailures,\n  };\n}", "calls": ["getDelegationUserCredentialsToProcess"], "called_by": ["handler"], "confidence": 0.86, "purpose": "async_function handleCreateSelectedCalendars", "behavior_patterns": ["ACCUMULATE(handleCreateSelectedC... -> result)", "TRANSFORM(map)"], "semantic_contract": {"purpose": "async_function handleCreateSelectedCalendars", "language": "typescript", "symbol_name": "handleCreateSelectedCalendars", "symbol_type": "async_function", "signature": "()", "behavior_patterns": ["ACCUMULATE(handleCreateSelectedC... -> result)", "TRANSFORM(map)"], "tier": 1, "calls": [{"target": "symbol:apps/web/app/api/cron/selected-calendars/route.ts:getDelegationUserCredentialsToProcess:59", "is_external": false}], "uses": ["CredentialRepository.findAllDelegationByTypeIncludeUserAndTake", "log.info", "allDelegationUserCredentials.length", "allDelegationUserCredentials.reduce", "curr.delegationCredentialId", "Object.entries", "delegationUserCredentialsToProcess.length", "Promise.allSettled"], "called_by": [{"source": "symbol:apps/web/app/api/cron/selected-calendars/route.ts:handler:298"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
