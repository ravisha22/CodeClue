{"node_id": "symbol:packages/features/watchlist/lib/repository/OrganizationWatchlistRepository.ts:OrganizationWatchlistRepository:13", "symbol": "OrganizationWatchlistRepository", "type": "class", "file": "packages/features/watchlist/lib/repository/OrganizationWatchlistRepository.ts", "lines": [13, 178], "source": "export class OrganizationWatchlistRepository implements IOrganizationWatchlistRepository {\n  constructor(private readonly prisma: PrismaClient) {}\n\n  private readonly selectFields = {\n    id: true,\n    type: true,\n    value: true,\n    description: true,\n    isGlobal: true,\n    organizationId: true,\n    action: true,\n    source: true,\n    lastUpdatedAt: true,\n  } as const;\n\n  async findBlockedEmail({\n    email,\n    organizationId,\n  }: {\n    email: string;\n    organizationId: number;\n  }): Promise<Watchlist | null> {\n    return this.prisma.watchlist.findFirst({\n      select: this.selectFields,\n      where: {\n        type: WatchlistType.EMAIL,\n        value: email,\n        action: WatchlistAction.BLOCK,\n        organizationId,\n      },\n    });\n  }\n\n  async findBlockedDomain(domain: string, organizationId: number): Promise<Watchlist | null> {\n    return this.prisma.watchlist.findFirst({\n      select: this.selectFields,\n      where: {\n        type: WatchlistType.DOMAIN,\n        value: domain,\n        action: WatchlistAction.BLOCK,\n        organizationId,\n      },\n    });\n  }\n\n  async listBlockedEntries(organizationId: number): Promise<Watchlist[]> {\n    return this.prisma.watchlist.findMany({\n      select: this.selectFields,\n      where: {\n        organizationId,\n        action: WatchlistAction.BLOCK,\n      },\n    });\n  }\n\n  async listAllOrganizationEntries(): Promise<Watchlist[]> {\n    return this.prisma.watchlist.findMany({\n      select: this.selectFields,\n      where: {\n        organizationId: { not: null },\n        isGlobal: false,\n        action: WatchlistAction.BLOCK,\n      },\n    });\n  }\n\n  /**\n   * Batch find blocking entries for multiple emails and domains within an organization.\n   * Single query for N users - eliminates N+1.\n   */\n  async findBlockingEntriesForEmailsAndDomains(params: {\n    emails: string[];\n    domains: string[];\n    organizationId: number;\n  }): Promise<Watchlist[]> {\n    const { emails, domains, organizationId } = params;\n\n    if (emails.length === 0 && domains.length === 0) {\n      return [];\n    }\n\n    const conditions: Array<{ type: WatchlistType; value: { in: string[] } }> = [];\n\n    if (emails.length > 0) {\n      conditions.push({ type: WatchlistType.EMAIL, value: { in: emails } });\n    }\n\n    if (domains.length > 0) {\n      conditions.push({ type: WatchlistType.DOMAIN, value: { in: domains } });\n    }\n\n    return this.prisma.watchlist.findMany({\n      select: this.selectFields,\n      where: {\n        organizationId,\n        action: WatchlistAction.BLOCK,\n        OR: conditions,\n      },\n    });\n  }\n\n  async findById(id: string, organizationId: number): Promise<Watchlist | null> {\n    return this.prisma.watchlist.findFirst({\n      select: this.selectFields,\n      where: {\n        id,\n        organizationId,\n      },\n    });\n  }\n\n  // Write operations for organization-specific entries\n  async createEntry(\n    organizationId: number,\n    data: {\n      type: WatchlistType;\n      value: string;\n      description?: string;\n      action: WatchlistAction;\n      source?: WatchlistSource;\n    }\n  ): Promise<Watchlist> {\n    return this.prisma.watchlist.create({\n      select: this.selectFields,\n      data: {\n        type: data.type,\n        value: data.value,\n        description: data.description,\n        isGlobal: false,\n        organizationId,\n        action: data.action,\n        source: data.source || WatchlistSource.MANUAL,\n      },\n    });\n  }\n\n  async updateEntry(\n    id: string,\n    organizationId: number,\n    data: {\n      value?: string;\n      description?: string | null;\n      action?: WatchlistAction;\n      source?: WatchlistSource;\n    }\n  ): Promise<Watchlist> {\n    return this.prisma.watchlist.update({\n      select: this.selectFields,\n      where: { id, organizationId },\n      data: {\n        ...(data.value !== undefined && { value: data.value }),\n        ...(data.description !== undefined && { description: data.description }),\n        ...(data.action !== undefined && { action: data.action }),\n        ...(data.source !== undefined && { source: data.source }),\n      },\n    });\n  }\n\n  async deleteEntry(id: string, organizationId: number): Promise<void> {\n    return this.prisma.watchlist\n      .delete({\n        where: { id, organizationId },\n      })\n      .then(() => {});\n  }\n}", "calls": ["OrganizationWatchlistRepository.constructor", "OrganizationWatchlistRepository.deleteEntry", "OrganizationWatchlistRepository.findBlockedDomain", "OrganizationWatchlistRepository.findById", "OrganizationWatchlistRepository.listAllOrganizationEntries", "OrganizationWatchlistRepository.listBlockedEntries"], "called_by": [], "confidence": 0.86, "purpose": "class OrganizationWatchlistRepository", "behavior_patterns": [], "semantic_contract": {"purpose": "class OrganizationWatchlistRepository", "language": "typescript", "symbol_name": "OrganizationWatchlistRepository", "symbol_type": "class", "signature": "", "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:packages/features/watchlist/lib/repository/OrganizationWatchlistRepository.ts:OrganizationWatchlistRepository.constructor:14", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/repository/OrganizationWatchlistRepository.ts:OrganizationWatchlistRepository.deleteEntry:171", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/repository/OrganizationWatchlistRepository.ts:OrganizationWatchlistRepository.findBlockedDomain:46", "is_external": false}, {"target": "symbol:packages/features/watch