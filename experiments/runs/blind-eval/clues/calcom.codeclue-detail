{"node_id": "symbol:packages/app-store/_utils/stripe.ts:getStripeCustomerId:34", "symbol": "getStripeCustomerId", "type": "async_function", "file": "packages/app-store/_utils/stripe.ts", "lines": [34, 67], "source": "export async function getStripeCustomerId(user: UserType): Promise<string> {\n  let customerId: string | null = null;\n\n  if (user?.metadata && typeof user.metadata === \"object\" && \"stripeCustomerId\" in user.metadata) {\n    customerId = (user?.metadata as Prisma.JsonObject).stripeCustomerId as string;\n  } else {\n    /* We fallback to finding the customer by email (which is not optimal) */\n    const customersResponse = await stripe.customers.list({\n      email: user.email,\n      limit: 1,\n    });\n    if (customersResponse.data[0]?.id) {\n      customerId = customersResponse.data[0].id;\n    } else {\n      /* Creating customer on Stripe and saving it on prisma */\n      const customer = await stripe.customers.create({ email: user.email });\n      customerId = customer.id;\n    }\n\n    await prisma.user.update({\n      where: {\n        email: user.email,\n      },\n      data: {\n        metadata: {\n          ...(user.metadata as Prisma.JsonObject),\n          stripeCustomerId: customerId,\n        },\n      },\n    });\n  }\n\n  return customerId;\n}", "calls": [], "called_by": ["getStripeCustomerIdFromUserId"], "confidence": 0.86, "purpose": "async_function getStripeCustomerId", "behavior_patterns": [], "semantic_contract": {"purpose": "async_function getStripeCustomerId", "language": "typescript", "symbol_name": "getStripeCustomerId", "symbol_type": "async_function", "signature": "(user: UserType)", "behavior_patterns": [], "tier": 1, "calls": [], "uses": ["user.metadata", "Prisma.JsonObject", "stripe.customers.list", "user.email", "customersResponse.data", "stripe.customers.create", "customer.id", "prisma.user.update"], "called_by": [{"source": "symbol:packages/app-store/_utils/stripe.ts:getStripeCustomerIdFromUserId:6"}], "complexity_