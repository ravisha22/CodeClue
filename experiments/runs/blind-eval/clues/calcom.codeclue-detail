{"node_id": "symbol:packages/config/theme/generateColor.ts:hexToHSL:2", "symbol": "hexToHSL", "type": "function", "file": "packages/config/theme/generateColor.ts", "lines": [2, 44], "source": "\n// Yeah i stole this...\nconst hexToHSL = (hex: string): HSL => {\n  const result = /^#?([a-f\\d]{2})([a-f\\d]{2})([a-f\\d]{2})$/i.exec(hex) || [];\n  try {\n    let r = parseInt(result[1], 16);\n    let g = parseInt(result[2], 16);\n    let b = parseInt(result[3], 16);\n    (r /= 255), (g /= 255), (b /= 255);\n    const max = Math.max(r, g, b),\n      min = Math.min(r, g, b);\n    let h = 0,\n      s,\n      // eslint-disable-next-line prefer-const\n      l = (max + min) / 2;\n    if (max === min) {\n      h = s = 0; // achromatic\n    } else {\n      const d = max - min;\n      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);\n      switch (max) {\n        case r:\n          h = (g - b) / d + (g < b ? 6 : 0);\n          break;\n        case g:\n          h = (b - r) / d + 2;\n          break;\n        case b:\n          h = (r - g) / d + 4;\n          break;\n      }\n      h /= 6;\n    }\n    const HSL: HSL = { h: 0, s: 0, l: 0 };\n    HSL.h = Math.round(h * 360);\n    HSL.s = Math.round(s * 100);\n    HSL.l = Math.round(l * 100);\n    return HSL;\n  } catch (_error) {\n    console.log(hex);\n    return { h: 0, s: 0, l: 0 };\n  }\n};", "calls": [], "called_by": ["generateColor"], "confidence": 0.86, "purpose": "function hexToHSL", "behavior_patterns": ["DISPATCH(max)"], "semantic_contract": {"purpose": "function hexToHSL", "language": "typescript", "symbol_name": "hexToHSL", "symbol_type": "function", "signature": "(hex: string)", "behavior_patterns": ["DISPATCH(max)"], "tier": 1, "calls": [], "uses": ["i.exec", "Math.max", "Math.min", "HSL.h", "Math.round", "HSL.s", "HSL.l", "console.log"], "called_by": [{"source": "symbol:packages/config/theme/generateColor.ts:generateColor:71"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
