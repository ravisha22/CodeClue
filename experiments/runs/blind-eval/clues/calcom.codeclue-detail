NOT_EXISTS\") {\n    return (\n      <Message\n        message={{\n          text: `${isTemplate ? \"Template\" : \"App\"} with slug ${slug} doesn't exist`,\n          type: \"error\",\n        }}\n      />\n    );\n  }\n  if (state === \"DELETION_CONFIRMATION_SUCCESSFUL\") {\n    return (\n      <Message\n        message={{\n          text: `Deleting ${isTemplate ? \"Template\" : \"App\"}`,\n          type: \"info\",\n          showInProgressIndicator: true,\n        }}\n      />\n    );\n  }\n\n  if (state === \"DELETION_COMPLETED\") {\n    return (\n      <Message\n        message={{\n          text: `${\n            isTemplate ? \"Template\" : \"App\"\n          } with slug \"${slug}\" has been deleted. You might need to restart your dev environment`,\n          type: \"success\",\n        }}\n      />\n    );\n  }\n  if (state === \"DELETION_CONFIRMATION_FAILED\") {\n    return (\n      <Message\n        message={{\n          text: `Slug doesn't match - Should have been ${slug}`,\n          type: \"error\",\n        }}\n      />\n    );\n  }\n  return null;\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "function DeleteForm", "behavior_patterns": ["PRECEDENCE(not_app -> state -> default)"], "semantic_contract": {"purpose": "function DeleteForm", "language": "typescript", "symbol_name": "DeleteForm", "symbol_type": "function", "signature": "({ slug, action }: { slug: string; action: \"delete\" | \"del...)", "behavior_patterns": ["PRECEDENCE(not_app -> state -> default)"], "tier": 1, "calls": [], "uses": ["BaseAppFork.delete"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
