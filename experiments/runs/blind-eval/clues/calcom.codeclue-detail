},\n        create: data,\n        update: data,\n      });\n    } catch (reason) {\n      logger.error(\"Could not add this apple calendar account\", reason);\n      return res.status(500).json({ message: \"unable_to_add_apple_calendar\" });\n    }\n\n    return res\n      .status(200)\n      .json({ url: getInstalledAppPath({ variant: \"calendar\", slug: \"apple-calendar\" }) });\n  }\n\n  if (req.method === \"GET\") {\n    return res.status(200).json({ url: \"/apps/apple-calendar/setup\" });\n  }\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "async_function handler", "behavior_patterns": ["PRECEDENCE(req -> decryptedCredential)"], "semantic_contract": {"purpose": "async_function handler", "language": "typescript", "symbol_name": "handler", "symbol_type": "async_function", "signature": "(req: NextApiRequest, res: NextApiResponse)", "behavior_patterns": ["PRECEDENCE(req -> decryptedCredential)"], "tier": 1, "calls": [], "uses": ["req.method", "req.body", "prisma.user.findFirstOrThrow", "req.session", "user.credentials.find", "JSON.parse", "credential.key", "process.env.CALENDSO_ENCRYPTION_KEY"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
