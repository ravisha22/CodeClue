 recording,\n        },\n        booking: {\n          userId: booking?.user?.id,\n          eventTypeId: booking.eventTypeId,\n          eventTypeParentId: booking.eventType?.parentId,\n          teamId,\n        },\n      });\n\n      return NextResponse.json({ message: \"Success\" });\n    } else {\n      log.error(\"Invalid type in /recorded-daily-video\", body);\n      return NextResponse.json({\n        message: \"Invalid type in /recorded-daily-video\",\n      });\n    }\n  } catch (err) {\n    log.error(\"Error in /recorded-daily-video\", err);\n\n    if (err instanceof HttpError) {\n      return NextResponse.json({ message: err.message }, { status: err.statusCode });\n    } else {\n      return NextResponse.json({ message: \"something went wrong\" }, { status: 500 });\n    }\n  }\n}", "calls": ["computeSignature", "getProxyDownloadLinkOfCalVideo", "getProxyDownloadLinkOfCalVideo"], "called_by": [], "confidence": 0.86, "purpose": "async_function postHandler", "behavior_patterns": ["PRECEDENCE(not_testMode -> not_hmacSecret -> body -> default)", "ACCUMULATE(postHandler loop -> result)", "TRANSFORM(map)"], "semantic_contract": {"purpose": "async_function postHandler", "language": "typescript", "symbol_name": "postHandler", "symbol_type": "async_function", "signature": "(request: NextRequest)", "behavior_patterns": ["PRECEDENCE(not_testMode -> not_hmacSecret -> body -> default)", "ACCUMULATE(postHandler loop -> result)", "TRANSFORM(map)"], "tier": 1, "calls": [{"target": "symbol:apps/web/app/api/recorded-daily-video/route.ts:computeSignature:39", "is_external": false}, {"target": "symbol:apps/web/app/api/recorded-daily-video/route.ts:getProxyDownloadLinkOfCalVideo:47", "is_external": false}], "uses": ["request.json", "testRequestSchema.safeParse", "NextResponse.json", "process.env.NEXT_PUBLIC_IS_E2E", "process.env.INTEGRATION_TEST_MODE", "process.env.DAILY_WEBHOOK_SECRET", "headersList.get", "log.info"], "called_by": [], "complexity_indicators": {"decorator_dep