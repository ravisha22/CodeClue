{"node_id": "symbol:packages/lib/csvUtils.ts:downloadAsCsv:1", "symbol": "downloadAsCsv", "type": "function", "file": "packages/lib/csvUtils.ts", "lines": [1, 21], "source": "export const downloadAsCsv = (data: string | Record<string, any>[], filename: string) => {\n  // If data is an array of objects, convert it to CSV string\n  const csvString = typeof data === \"string\" ? data : objectsToCsv(data);\n\n  // Create a Blob from the text data\n  const blob = new Blob([csvString], { type: \"text/plain\" });\n\n  // Create an Object URL for the Blob\n  const url = window.URL.createObjectURL(blob);\n\n  // Create a download link\n  const a = document.createElement(\"a\");\n  a.href = url;\n  a.download = filename;\n\n  // Simulate a click event to trigger the download\n  a.click();\n\n  // Release the Object URL to free up memory\n  window.URL.revokeObjectURL(url);\n};", "calls": ["objectsToCsv"], "called_by": [], "confidence": 0.86, "purpose": "function downloadAsCsv", "behavior_patterns": [], "semantic_contract": {"purpose": "function downloadAsCsv", "language": "typescript", "symbol_name": "downloadAsCsv", "symbol_type": "function", "signature": "(data: string | Record<string, any>[], filename: string)", "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:packages/lib/csvUtils.ts:objectsToCsv:22", "is_external": false}], "uses": ["window.URL.createObjectURL", "document.createElement", "a.href", "a.download", "a.click", "window.URL.revokeObjectURL"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
