mpt ${retries + 1}/${\n            maxRetries + 1\n          })`\n        );\n        await new Promise((resolve) => setTimeout(resolve, backoffDelay));\n        retries++;\n        continue;\n      }\n\n      console.error(`Error deleting recording ${recordingId} after ${retries + 1} attempts:`, error);\n      return false;\n    }\n  }\n\n  console.error(`Failed to delete recording ${recordingId} after ${maxRetries + 1} attempts`);\n  return false;\n}", "calls": [], "called_by": ["deleteRecordingsFromJson"], "confidence": 0.86, "purpose": "async_function deleteRecording", "behavior_patterns": ["GUARD(response.ok -> const result = awai...)", "PRECEDENCE(response)"], "semantic_contract": {"purpose": "async_function deleteRecording", "language": "typescript", "symbol_name": "deleteRecording", "symbol_type": "async_function", "signature": "(recordingId: string, apiKey: string)", "behavior_patterns": ["GUARD(response.ok -> const result = awai...)", "PRECEDENCE(response)"], "tier": 1, "calls": [], "uses": ["api.daily.co", "response.ok", "response.json", "result.deleted", "response.status", "console.log", "Math.pow", "console.error"], "called_by": [{"source": "symbol:packages/app-store/dailyvideo/lib/scripts/deleteRecordings.ts:deleteRecordingsFromJson:310"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
