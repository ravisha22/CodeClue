(htmlResponse);\n  } else {\n    res.status(405).end(); // Method Not Allowed\n  }\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "async_function handler", "behavior_patterns": ["PRECEDENCE(req -> not_cal -> ar -> default)"], "semantic_contract": {"purpose": "async_function handler", "language": "typescript", "symbol_name": "handler", "symbol_type": "async_function", "signature": "(req: NextApiRequest, res: NextApiResponse)", "behavior_patterns": ["PRECEDENCE(req -> not_cal -> ar -> default)"], "tier": 1, "calls": [], "uses": ["req.method", "res.setHeader", "req.query.url", "res.status", "i.test", "parsedUrl.hostname.toLowerCase", "cal.com", "hostname.endsWith"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
