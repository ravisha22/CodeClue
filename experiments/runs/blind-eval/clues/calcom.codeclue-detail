ed", "SpamCheckService.isBlocked", "SpamCheckService.isBlocked", "SpamCheckService.startCheck", "SpamCheckService.startCheck", "SpamCheckService.waitForCheck", "SpamCheckService.waitForCheck"], "called_by": [], "confidence": 0.86, "purpose": "class SpamCheckService", "behavior_patterns": [], "semantic_contract": {"purpose": "class SpamCheckService", "language": "typescript", "symbol_name": "SpamCheckService", "symbol_type": "class", "signature": "", "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:packages/features/watchlist/lib/service/SpamCheckService.ts:SpamCheckService.isBlocked:42", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/service/SpamCheckService.ts:SpamCheckService.startCheck:22", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/service/SpamCheckService.ts:SpamCheckService.waitForCheck:29", "is_external": false}], "uses": ["this.spamCheckPromise", "this.isBlocked", "logger.error", "this.globalBlockingService.isBlocked", "checks.push", "this.organizationBlockingService.isBlocked", "Promise.all", "globalResult.isBlocked"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
