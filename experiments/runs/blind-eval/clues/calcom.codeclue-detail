{"node_id": "symbol:packages/features/watchlist/operations/check-user-blocking.ts:checkWatchlistBlocking:32", "symbol": "checkWatchlistBlocking", "type": "async_function", "file": "packages/features/watchlist/operations/check-user-blocking.ts", "lines": [32, 72], "source": "\nexport async function checkWatchlistBlocking(\n  emails: string[],\n  organizationId?: number | null\n): Promise<Map<string, boolean>> {\n  try {\n    const watchlist = await getWatchlistFeature();\n\n    // Batch check - single DB query for all emails\n    const globalBlockedMap = await watchlist.globalBlocking.areBlocked(emails);\n\n    let orgBlockedMap: Map<string, { isBlocked: boolean }> | null = null;\n    if (organizationId) {\n      orgBlockedMap = await watchlist.orgBlocking.areBlocked(emails, organizationId);\n    }\n\n    const result = new Map<string, boolean>();\n    for (const email of emails) {\n      const normalizedEmail = email.trim().toLowerCase();\n      const globalResult = globalBlockedMap.get(normalizedEmail);\n      const orgResult = orgBlockedMap?.get(normalizedEmail);\n\n      result.set(normalizedEmail, !!(globalResult?.isBlocked || orgResult?.isBlocked));\n    }\n\n    return result;\n  } catch (error) {\n    // Fail-open: If watchlist check fails, allow booking to proceed\n    // This ensures availability even if watchlist service is down\n    let errorMessage = \"Unknown error\";\n    if (error instanceof Error) {\n      errorMessage = error.message;\n    }\n    log.error(\"Watchlist check failed, allowing users through (fail-open)\", {\n      error: errorMessage,\n      emailCount: emails.length,\n      organizationId,\n    });\n    return new Map(emails.map((e) => [e.trim().toLowerCase(), false]));\n  }\n}", "calls": [], "called_by": ["getBlockedUsersMap"], "confidence": 0.86, "purpose": "async_function checkWatchlistBlocking", "behavior_patterns": ["PRECEDENCE(organizationId -> isinstance_Error)", "ACCUMULATE(getWatchlistFeature loop -> result)", "TRANSFORM(map)"], "semantic_contract": {"purpose": "async_function checkWatchlistBlocking", "language": "typescript", "symbol_name": "checkWatchlistBlocking", "symbol_type": "async_function", "signature": "(emails: string[], organizationId?: number | null)", "behavior_patterns": ["PRECEDENCE(organizationId -> isinstance_Error)", "ACCUMULATE(getWatchlistFeature loop -> result)", "TRANSFORM(map)"], "tier": 1, "calls": [], "uses": ["watchlist.globalBlocking.areBlocked", "watchlist.orgBlocking.areBlocked", "email.trim", "globalBlockedMap.get", "result.set", "error.message", "log.error", "emails.length"], "called_by": [{"source": "symbol:packages/features/watchlist/operations/check-user-blocking.ts:getBlockedUsersMap:86"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
