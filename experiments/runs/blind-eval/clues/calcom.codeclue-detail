    bookingId,\n                  });\n                }}>\n                {t(\"charge_attendee\", currencyStringParams)}\n              </Button>\n            </DialogFooter>\n          </div>\n        </div>\n      </DialogContent>\n    </Dialog>\n  );\n};", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "function ChargeCardDialog", "behavior_patterns": [], "semantic_contract": {"purpose": "function ChargeCardDialog", "language": "typescript", "symbol_name": "ChargeCardDialog", "symbol_type": "function", "signature": "(props: IRescheduleDialog)", "behavior_patterns": [], "tier": 1, "calls": [], "uses": ["trpc.useUtils", "utils.viewer.bookings.invalidate", "props.paymentAmount", "props.paymentCurrency", "chargeCardMutation.isPending", "chargeCardMutation.mutate"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
