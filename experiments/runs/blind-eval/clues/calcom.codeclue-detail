{"node_id": "symbol:packages/app-store/_utils/useIsAppEnabled.ts:useIsAppEnabled:6", "symbol": "useIsAppEnabled", "type": "function", "file": "packages/app-store/_utils/useIsAppEnabled.ts", "lines": [6, 36], "source": "\nfunction useIsAppEnabled(app: EventTypeAppCardApp) {\n  const { getAppData, setAppData } = useAppContextWithSchema();\n  const [enabled, setEnabled] = useState(() => {\n    const isAppEnabled = getAppData(\"enabled\");\n\n    if (!app.credentialOwner) {\n      return isAppEnabled ?? false; // Default to false if undefined\n    }\n\n    const credentialId = getAppData(\"credentialId\");\n    const isAppEnabledForCredential =\n      isAppEnabled &&\n      (app.userCredentialIds.some((id: number) => id === credentialId) ||\n        app.credentialOwner.credentialId === credentialId);\n    return isAppEnabledForCredential ?? false; // Default to false if undefined\n  });\n\n  const updateEnabled = (newValue: boolean) => {\n    if (!newValue) {\n      setAppData(\"credentialId\", undefined);\n    }\n\n    if (newValue && (app.userCredentialIds?.length || app.credentialOwner?.credentialId)) {\n      setAppData(\"credentialId\", app.credentialOwner?.credentialId || app.userCredentialIds[0]);\n    }\n    setEnabled(newValue);\n  };\n\n  return { enabled, updateEnabled };\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "function useIsAppEnabled", "behavior_patterns": ["PRECEDENCE(not_app -> not_newValue)"], "semantic_contract": {"purpose": "function useIsAppEnabled", "language": "typescript", "symbol_name": "useIsAppEnabled", "symbol_type": "function", "signature": "(app: EventTypeAppCardApp)", "behavior_patterns": ["PRECEDENCE(not_app -> not_newValue)"], "tier": 1, "calls": [], "uses": ["app.credentialOwner", "app.userCredentialIds.some", "app.credentialOwner.credentialId", "app.userCredentialIds"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
