 access_token, refresh_token, expires_in } = responseJson;\n    const expires_at = Date.now() + expires_in * 1000;\n\n    await prisma.credential.create({\n      data: {\n        type: \"closecom_crm\",\n        key: {\n          access_token,\n          refresh_token,\n          expires_at,\n        },\n        userId: req.session.user.id,\n        appId: \"closecom\",\n      },\n    });\n\n    return res.redirect(redirectAfterSuccess);\n  } catch (error) {\n    console.error(\"Error getting close.com access token\", error);\n    return res.redirect(`${redirectAfterSuccessOrError}?error=Error getting close.com access token`);\n  }\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "async_function getHandler", "behavior_patterns": ["GUARD(state?.onErrorReturnTo || state?.returnTo -> res.redirect(redire...)", "PRECEDENCE(not_code -> state -> not_req)"], "semantic_contract": {"purpose": "async_function getHandler", "language": "typescript", "symbol_name": "getHandler", "symbol_type": "async_function", "signature": "(req: NextApiRequest, res: NextApiResponse)", "behavior_patterns": ["GUARD(state?.onErrorReturnTo || state?.returnTo -> res.redirect(redire...)", "PRECEDENCE(not_code -> state -> not_req)"], "tier": 1, "calls": [], "uses": ["req.query", "appConfig.variant", "appConfig.slug", "res.redirect", "req.session", "res.status", "Close.com", "api.close.com"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
