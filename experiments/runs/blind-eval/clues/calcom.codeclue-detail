p,\n    blockedCount: lockedCount + watchlistBlockedCount,\n    lockedCount,\n    watchlistBlockedCount,\n  };\n}", "calls": ["checkWatchlistBlocking"], "called_by": [], "confidence": 0.86, "purpose": "async_function getBlockedUsersMap", "behavior_patterns": ["PRECEDENCE(validUsers -> user -> nonLockedUsers -> default)", "ACCUMULATE(map loop -> result)", "TRANSFORM(map)"], "semantic_contract": {"purpose": "async_function getBlockedUsersMap", "language": "typescript", "symbol_name": "getBlockedUsersMap", "symbol_type": "async_function", "signature": "(users: T[], organizationId?: number | null)", "behavior_patterns": ["PRECEDENCE(validUsers -> user -> nonLockedUsers -> default)", "ACCUMULATE(map loop -> result)", "TRANSFORM(map)"], "tier": 1, "calls": [{"target": "symbol:packages/features/watchlist/operations/check-user-blocking.ts:checkWatchlistBlocking:32", "is_external": false}], "uses": ["u.email", "u.email.length", "validUsers.length", "user.email.toLowerCase", "user.locked", "blockingMap.set", "nonLockedUsers.push", "nonLockedUsers.length"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
