wAvatar);\n              const ev2 = new Event(\"input\", { bubbles: true });\n              avatarRef.current?.dispatchEvent(ev2);\n              updateProfileHandler(newAvatar);\n            }}\n            imageSrc={imageSrc}\n          />\n        </div>\n      </div>\n      <fieldset className=\"mt-8\">\n        <Label className=\"text-default mb-2 block text-sm font-medium\">{t(\"about\")}</Label>\n        <Editor\n          getText={() => md.render(getValues(\"bio\") || user?.bio || \"\")}\n          setText={(value: string) => setValue(\"bio\", turndown(value))}\n          excludedToolbarItems={[\"blockType\"]}\n          firstRender={firstRender}\n          setFirstRender={setFirstRender}\n        />\n        <p className=\"text-default mt-2 font-sans text-sm font-normal\">{t(\"few_sentences_about_yourself\")}</p>\n      </fieldset>\n      <Button\n        loading={mutation.isPending}\n        EndIcon=\"arrow-right\"\n        type=\"submit\"\n        className=\"mt-8 w-full items-center justify-center\">\n        {t(\"finish_and_start\")}\n      </Button>\n    </form>\n  );\n};", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "function UserProfile", "behavior_patterns": ["PRECEDENCE(eventTypes -> avatarRef)", "TRANSFORM(map)"], "semantic_contract": {"purpose": "function UserProfile", "language": "typescript", "symbol_name": "UserProfile", "symbol_type": "function", "signature": "({ user }: UserProfileProps)", "behavior_patterns": ["PRECEDENCE(eventTypes -> avatarRef)", "TRANSFORM(map)"], "tier": 1, "calls": [], "uses": ["trpc.viewer.eventTypes.list.useQuery", "trpc.useUtils", "trpc.viewer.eventTypesHeavy.create.useMutation", "trpc.viewer.me.updateProfile.useMutation", "data.avatarUrl", "Promise.all", "DEFAULT_EVENT_TYPES.map", "createEventType.mutate"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
