{"node_id": "symbol:apps/web/modules/apps/installed/[category]/installed-category-view.tsx:InstalledApps:187", "symbol": "InstalledApps", "type": "function", "file": "apps/web/modules/apps/installed/[category]/installed-category-view.tsx", "lines": [187, 261], "source": "\nexport default function InstalledApps({ category, connectedCalendars, installedCalendars }: PageProps) {\n  const { t } = useLocale();\n  const utils = trpc.useUtils();\n  const categoryList: AppCategories[] = Object.values(AppCategories).filter((category) => {\n    // Exclude calendar and other from categoryList, we handle those slightly differently below\n    return !(category in { other: null, calendar: null });\n  });\n\n  const [data, updateData] = useReducer(\n    (data: ModalState, partialData: Partial<ModalState>) => ({ ...data, ...partialData }),\n    {\n      isOpen: false,\n      credentialId: null,\n    }\n  );\n\n  const handleModelClose = () => {\n    updateData({ isOpen: false, credentialId: null });\n  };\n\n  const handleDisconnect = (credentialId: number, app: string, teamId?: number) => {\n    updateData({ isOpen: true, credentialId, teamId });\n  };\n\n  const deleteCredentialMutation = trpc.viewer.credentials.delete.useMutation();\n\n  const handleRemoveApp = ({ credentialId, teamId, callback }: RemoveAppParams) => {\n    deleteCredentialMutation.mutate(\n      { id: credentialId, teamId },\n      {\n        onSuccess: () => {\n          showToast(t(\"app_removed_successfully\"), \"success\");\n          callback();\n          utils.viewer.apps.integrations.invalidate();\n          utils.viewer.calendars.connectedCalendars.invalidate();\n        },\n        onError: () => {\n          showToast(t(\"error_removing_app\"), \"error\");\n          callback();\n        },\n      }\n    );\n  };\n\n  return (\n    <>\n      <InstalledAppsLayout heading={t(\"installed_apps\")} subtitle={t(\"manage_your_connected_apps\")}>\n        {categoryList.includes(category) && (\n          <IntegrationsContainer handleDisconnect={handleDisconnect} variant={category} />\n        )}\n        {category === \"calendar\" && (\n          <CalendarListContainer\n            connectedCalendars={connectedCalendars}\n            installedCalendars={installedCalendars}\n          />\n        )}\n        {category === \"other\" && (\n          <IntegrationsContainer\n            handleDisconnect={handleDisconnect}\n            variant={category}\n            exclude={[...categoryList, \"calendar\"]}\n          />\n        )}\n      </InstalledAppsLayout>\n      <DisconnectIntegrationModal\n        handleModelClose={handleModelClose}\n        isOpen={data.isOpen}\n        credentialId={data.credentialId}\n        teamId={data.teamId}\n        handleRemoveApp={handleRemoveApp}\n      />\n    </>\n  );\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "function InstalledApps", "behavior_patterns": [], "semantic_contract": {"purpose": "function InstalledApps", "language": "typescript", "symbol_name": "InstalledApps", "symbol_type": "function", "signature": "({ category, connectedCalendars, installedCalendars }: Pag...)", "behavior_patterns": [], "tier": 1, "calls": [], "uses": ["trpc.useUtils", "Object.values", "trpc.viewer.credentials.delete.useMutation", "deleteCredentialMutation.mutate", "utils.viewer.apps.integrations.invalidate", "utils.viewer.calendars.connectedCalendars.invalidate", "categoryList.includes", "data.isOpen"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
