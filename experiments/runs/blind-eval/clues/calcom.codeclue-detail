dAt: true,\n        bookingId: true,\n        reasonEnum: true,\n        reasonString: true,\n      },\n    });\n  }\n}", "calls": ["AssignmentReasonRepository.constructor", "AssignmentReasonRepository.findByBookingId", "AssignmentReasonRepository.findLatestByBookingId"], "called_by": [], "confidence": 0.86, "purpose": "class AssignmentReasonRepository", "behavior_patterns": [], "semantic_contract": {"purpose": "class AssignmentReasonRepository", "language": "typescript", "symbol_name": "AssignmentReasonRepository", "symbol_type": "class", "signature": "", "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:packages/features/assignment-reason/repositories/AssignmentReasonRepository.ts:AssignmentReasonRepository.constructor:8", "is_external": false}, {"target": "symbol:packages/features/assignment-reason/repositories/AssignmentReasonRepository.ts:AssignmentReasonRepository.findByBookingId:36", "is_external": false}, {"target": "symbol:packages/features/assignment-reason/repositories/AssignmentReasonRepository.ts:AssignmentReasonRepository.findLatestByBookingId:54", "is_external": false}], "uses": ["log.debug", "data.bookingId", "data.reasonEnum", "this.prismaClient.assignmentReason.create", "data.reasonString", "this.prismaClient.assignmentReason.findMany", "this.prismaClient.assignmentReason.findFirst"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
