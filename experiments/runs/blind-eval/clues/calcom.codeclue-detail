{"node_id": "symbol:packages/trpc/server/routers/viewer/availability/schedule/getAllSchedulesByUserId.handler.ts:getAllSchedulesByUserIdHandler:19", "symbol": "getAllSchedulesByUserIdHandler", "type": "async_function", "file": "packages/trpc/server/routers/viewer/availability/schedule/getAllSchedulesByUserId.handler.ts", "lines": [19, 63], "source": "\nexport const getAllSchedulesByUserIdHandler = async ({ ctx, input }: GetOptions) => {\n  const { user } = ctx;\n\n  const isCurrentUserPartOfTeam = await hasReadPermissionsForUserId({ memberId: input?.userId, userId: user.id });\n\n  const isCurrentUserOwner = input?.userId === user.id;\n\n  if (!isCurrentUserPartOfTeam && !isCurrentUserOwner) {\n    throw new TRPCError({\n      code: \"UNAUTHORIZED\",\n    });\n  }\n\n  const schedules = await prisma.schedule.findMany({\n    where: {\n      userId: input.userId,\n    },\n    select: {\n      id: true,\n      userId: true,\n      name: true,\n    },\n  });\n\n  if (!schedules) {\n    log.error(`No Schedules found for userId:${input.userId}`);\n    throw new TRPCError({\n      code: \"NOT_FOUND\",\n    });\n  }\n\n  const scheduleRepository = new ScheduleRepository(prisma);\n  const defaultScheduleId = await scheduleRepository.getDefaultScheduleId(input.userId);\n\n  return {\n    schedules: schedules.map((schedule) => {\n      return {\n        ...schedule,\n        isDefault: schedule.id === defaultScheduleId,\n        readOnly: schedule.userId !== user.id,\n      };\n    }),\n  };\n};", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "async_function getAllSchedulesByUserIdHandler", "behavior_patterns": ["PRECEDENCE(not_isCurrentUserPartOfTeam -> not_schedules)", "TRANSFORM(map)"], "semantic_contract": {"purpose": "async_function getAllSchedulesByUserIdHandler", "language": "typescript", "symbol_name": "getAllSchedulesByUserIdHandler", "symbol_type": "async_function", "signature": "({ ctx, input }: GetOptions)", "behavior_patterns": ["PRECEDENCE(not_isCu