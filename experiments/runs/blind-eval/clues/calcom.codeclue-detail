: number): Promise<boolean>;\n\n  /**\n   * Abstract method to get customer ID - implemented by subclasses\n   */\n  abstract getCustomerId(teamId: number): Promise<string | null>;\n\n  /**\n   * Process billing portal request for a team\n   */\n  async processBillingPortal(\n    userId: number,\n    teamId: number,\n    returnUrl: string,\n    res: NextApiResponse\n  ): Promise<void> {\n    // Check permissions\n    const hasPermission = await this.checkPermissions(userId, teamId);\n    if (!hasPermission) {\n      res.status(403).json({ message: \"Forbidden\" });\n      return;\n    }\n\n    // Get customer ID\n    const customerId = await this.getCustomerId(teamId);\n    if (!customerId) {\n      res.status(400).json({\n        message: `${this.contextName} billing not properly configured. Please contact support.`,\n      });\n      return;\n    }\n\n    // Create portal URL and redirect\n    const billingPortalUrl = await this.createBillingPortalUrl(customerId, returnUrl);\n    res.redirect(302, billingPortalUrl);\n  }\n}", "calls": ["BillingPortalService.buildReturnUrl", "BillingPortalService.checkPermissions", "BillingPortalService.checkPermissions", "BillingPortalService.createBillingPortalUrl", "BillingPortalService.createBillingPortalUrl", "BillingPortalService.getCustomerId", "BillingPortalService.getCustomerId", "BillingPortalService.getValidatedTeamSubscriptionId", "BillingPortalService.getValidatedTeamSubscriptionIdForPlatform"], "called_by": [], "confidence": 0.86, "purpose": "class BillingPortalService", "behavior_patterns": [], "semantic_contract": {"purpose": "class BillingPortalService", "language": "typescript", "symbol_name": "BillingPortalService", "symbol_type": "class", "signature": "", "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:packages/app-store/stripepayment/lib/services/base/BillingPortalService.ts:BillingPortalService.buildReturnUrl:47", "is_external": false}, {"target": "symbol:packages/app-store/stripepayment/lib/s