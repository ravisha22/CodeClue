{"node_id": "symbol:packages/features/auth/signup/username.ts:usernameCheck:76", "symbol": "usernameCheck", "type": "async_function", "file": "packages/features/auth/signup/username.ts", "lines": [76, 127], "source": "\nconst usernameCheck = async (usernameRaw: string) => {\n  const response = {\n    available: true,\n    premium: false,\n    suggestedUsername: \"\",\n  };\n\n  const username = slugify(usernameRaw);\n\n  const user = await prisma.user.findUnique({\n    where: {\n      username_organizationId: {\n        username,\n        organizationId: null,\n      },\n    },\n    select: {\n      username: true,\n    },\n  });\n\n  if (user) {\n    response.available = false;\n  }\n\n  if (await isPremiumUserName(username)) {\n    response.premium = true;\n  }\n\n  // get list of similar usernames in the db\n  const users = await prisma.user.findMany({\n    where: {\n      username: {\n        contains: username,\n      },\n    },\n    select: {\n      username: true,\n    },\n  });\n\n  // We only need suggestedUsername if the username is not available\n  if (!response.available) {\n    response.suggestedUsername = await generateUsernameSuggestion(\n      users.map((user) => user.username).filter(notEmpty),\n      username\n    );\n  }\n\n  return response;\n};", "calls": [], "called_by": ["usernameHandler"], "confidence": 0.86, "purpose": "async_function usernameCheck", "behavior_patterns": ["TRANSFORM(map)"], "semantic_contract": {"purpose": "async_function usernameCheck", "language": "typescript", "symbol_name": "usernameCheck", "symbol_type": "async_function", "signature": "(usernameRaw: string)", "behavior_patterns": ["TRANSFORM(map)"], "tier": 1, "calls": [], "uses": ["prisma.user.findUnique", "response.available", "response.premium", "prisma.user.findMany", "response.suggestedUsername", "users.map", "user.username"], "called_by": [{"source": "symbol:packages/features/auth/signup/username.ts:usernameHandler:43"}], "complexity_indicators": {"decorator_depth