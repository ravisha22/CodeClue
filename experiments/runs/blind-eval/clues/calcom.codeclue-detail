        seatReferenceUid={seatReferenceUid}\n          currentUserEmail={currentUserEmail}\n          bookingCancelledEventProps={bookingCancelledEventProps}\n          isHost={isHost}\n          internalNotePresets={internalNotePresets}\n          eventTypeMetadata={eventTypeMetadata}\n          requiresCancellationReason={requiresCancellationReason}\n          showErrorAsToast={true}\n          onCanceled={handleCanceled}\n        />\n      </DialogContent>\n    </Dialog>\n  );\n};", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "function CancelBookingDialog", "behavior_patterns": [], "semantic_contract": {"purpose": "function CancelBookingDialog", "language": "typescript", "symbol_name": "CancelBookingDialog", "symbol_type": "function", "signature": "(props: ICancelBookingDialog)", "behavior_patterns": [], "tier": 1, "calls": [], "uses": ["trpc.useUtils", "booking.payment", "booking.payment.length", "utils.viewer.bookings.invalidate", "booking.uid", "booking.id", "booking.title", "booking.startTime"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
