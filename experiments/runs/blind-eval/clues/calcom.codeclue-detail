D\");\n      const bookingDateStr = bookingDate.format(\"YYYY-MM-DD\");\n\n      return {\n        type: \"data\" as const,\n        booking,\n        isToday: bookingDateStr === today,\n        recurringInfo: data.recurringInfo.find((info) => info.recurringEventId === booking.recurringEventId),\n      };\n    });\n  }, [data, status, user?.timeZone]);\n\n  return rowData;\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "function useBookingCalendarData", "behavior_patterns": ["GUARD(!data?.bookings -> return [];)", "PRECEDENCE(not_data -> status -> not_booking)", "TRANSFORM(map)"], "semantic_contract": {"purpose": "function useBookingCalendarData", "language": "typescript", "symbol_name": "useBookingCalendarData", "symbol_type": "function", "signature": "({ data, status }: UseBookingCalendarDataParams)", "behavior_patterns": ["GUARD(!data?.bookings -> return [];)", "PRECEDENCE(not_data -> status -> not_booking)", "TRANSFORM(map)"], "tier": 1, "calls": [], "uses": ["booking.recurringEventId", "data.bookings.filter", "booking.startTime", "bookingDate.format", "data.recurringInfo.find", "info.recurringEventId"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
