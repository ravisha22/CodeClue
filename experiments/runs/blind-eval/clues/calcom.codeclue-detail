penId);\n\n    return res.status(200).json({ code: 0, msg: \"success\" });\n  }\n\n  // used for handle user first talk with cal.com connector bot, see\n  // https://open.larksuite.com/document/ukTMukTMukTM/uYDNxYjL2QTM24iN0EjN/bot-events\n  if (req.body.event?.type === \"p2p_chat_create\") {\n    const {\n      body: {\n        tenant_key: tenantKey,\n        event: {\n          user: { open_id: senderOpenId },\n        },\n      },\n    } = p2pChatCreateEventsReqSchema.parse(req);\n\n    sendPostMsg(tenantKey, senderOpenId);\n\n    return res.status(200).json({ code: 0, msg: \"success\" });\n  }\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "async_function postHandler", "behavior_patterns": ["PRECEDENCE(req)"], "semantic_contract": {"purpose": "async_function postHandler", "language": "typescript", "symbol_name": "postHandler", "symbol_type": "async_function", "signature": "(req: NextApiRequest, res: NextApiResponse)", "behavior_patterns": ["PRECEDENCE(req)"], "tier": 1, "calls": [], "uses": ["log.debug", "req.body", "feishuKeysSchema.parse", "open.larksuite.com", "req.body.type", "req.body.token", "res.status", "req.body.challenge"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
