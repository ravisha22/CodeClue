l>\n          {credentials.map((cred) => (\n            <DropdownMenuItem key={cred.id}>\n              <DropdownItem\n                type=\"button\"\n                color=\"destructive\"\n                className=\"hover:bg-subtle hover:text-emphasis w-full border-0\"\n                StartIcon={cred.teamId ? \"users\" : \"user\"}\n                onClick={() => {\n                  setCredentialToDelete({\n                    id: cred.id,\n                    teamId: cred.teamId,\n                    name: getUserDisplayName(cred.user) || null,\n                  });\n                  setConfirmationDialogOpen(true);\n                }}>\n                <div className=\"flex flex-col text-left\">\n                  <span>{getUserDisplayName(cred.user) || t(\"unnamed\")}</span>\n                </div>\n              </DropdownItem>\n            </DropdownMenuItem>\n          ))}\n        </DropdownMenuContent>\n      </Dropdown>\n\n      <Dialog open={confirmationDialogOpen} onOpenChange={setConfirmationDialogOpen}>\n        <ConfirmationDialogContent\n          variety=\"danger\"\n          title={t(\"remove_app\")}\n          confirmBtnText={t(\"yes_remove_app\")}\n          onConfirm={() => {\n            if (credentialToDelete) {\n              mutation.mutate({\n                id: credentialToDelete.id,\n                ...(credentialToDelete.teamId ? { teamId: credentialToDelete.teamId } : {}),\n              });\n            }\n          }}>\n          <p className=\"mt-5\">\n            {t(\"are_you_sure_you_want_to_remove_this_app_from\")} {credentialToDelete?.name || t(\"unnamed\")}?\n          </p>\n        </ConfirmationDialogContent>\n      </Dialog>\n    </>\n  );\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "function MultiDisconnectIntegration", "behavior_patterns": ["TRANSFORM(map)"], "semantic_contract": {"purpose": "function MultiDisconnectIntegration", "language": "typescript", "symbol_name": "MultiDisconnectIntegration