{"node_id": "symbol:packages/features/bookings/services/BookingAccessService.ts:BookingAccessService.isUserAHost:22", "symbol": "BookingAccessService.isUserAHost", "type": "function", "file": "packages/features/bookings/services/BookingAccessService.ts", "lines": [22, 46], "source": "  private isUserAHost(userId: number, booking: BookingForAccessCheck): boolean {\n    const hostMap = new Map<number, { id: number; email: string }>();\n\n    const addHost = (id: number, email: string) => {\n      if (!hostMap.has(id)) {\n        hostMap.set(id, { id, email });\n      }\n    };\n\n    booking?.eventType?.hosts?.forEach((host: { userId: number; user: { email: string } }) =>\n      addHost(host.userId, host.user.email)\n    );\n    booking?.eventType?.users?.forEach((user: { id: number; email: string }) => addHost(user.id, user.email));\n\n    if (booking?.user?.id && booking?.user?.email) {\n      addHost(booking.user.id, booking.user.email);\n    }\n\n    const attendeeEmails = new Set(booking.attendees?.map((attendee: { email: string }) => attendee.email));\n    const filteredHosts = Array.from(hostMap.values()).filter(\n      (host) => attendeeEmails.has(host.email) || host.id === booking.user?.id\n    );\n\n    return filteredHosts.some((host) => host.id === userId);\n  }", "calls": [], "called_by": ["BookingAccessService", "BookingAccessService"], "confidence": 0.86, "purpose": "method BookingAccessService.isUserAHost", "behavior_patterns": ["DELEGATE(filteredHosts.some -> result)", "ACCUMULATE(isUserAHost loop -> result)", "TRANSFORM(map)"], "semantic_contract": {"purpose": "method BookingAccessService.isUserAHost", "language": "typescript", "symbol_name": "BookingAccessService.isUserAHost", "symbol_type": "method", "signature": "(userId: number, booking: BookingForAccessCheck)", "behavior_patterns": ["DELEGATE(filteredHosts.some -> result)", "ACCUMULATE(isUserAHost loop -> result)", "TRANSFORM(map)"], "tier": 1, "calls": [], "uses": ["hostMap.has", "hostMap.set",