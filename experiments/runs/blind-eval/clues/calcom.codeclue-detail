odes ? t(\"backup_codes\") : t(\"enable_2fa\")}\n        description={setupDescriptions[step]}\n        type=\"creation\">\n        <WithStep step={SetupStep.ConfirmPassword} current={step}>\n          <form onSubmit={handleSetup}>\n            <div className=\"mb-4\">\n              <PasswordField\n                label={t(\"password\")}\n                name=\"password\"\n                id=\"password\"\n                required\n                value={password}\n                onInput={(e) => setPassword(e.currentTarget.value)}\n              />\n              {errorMessage && <p className=\"mt-1 text-sm text-red-700\">{errorMessage}</p>}\n            </div>\n          </form>\n        </WithStep>\n        <WithStep step={SetupStep.DisplayQrCode} current={step}>\n          <>\n            <div className=\"-mt-3 flex justify-center\">\n              {\n                // eslint-disable-next-line @next/next/no-img-element\n                <img src={dataUri} alt={t(\"two_factor_auth_qr_code\")} />\n              }\n            </div>\n            <p data-testid=\"two-factor-secret\" className=\"mb-4 text-center font-mono text-xs\">\n              {secret}\n            </p>\n          </>\n        </WithStep>\n        <WithStep step={SetupStep.DisplayBackupCodes} current={step}>\n          <>\n            <div className=\"mt-5 grid grid-cols-2 gap-1 text-center font-mono md:pl-10 md:pr-10\">\n              {backupCodes.map((code) => (\n                <div key={code}>{formatBackupCode(code)}</div>\n              ))}\n            </div>\n          </>\n        </WithStep>\n        <Form handleSubmit={handleEnable} form={form}>\n          <WithStep step={SetupStep.EnterTotpCode} current={step}>\n            <div className=\"-mt-4 pb-2\">\n              <TwoFactor center />\n\n              {errorMessage && (\n                <p data-testid=\"error-submitting-code\" className=\"mt-1 text-sm text-red-700\">\n                  {errorMessage}\n                </p>\n              )}\n            </div>\n          </WithStep>\n          <DialogFooter className=\"mt-8\" showDivider>\n            {step !== SetupStep.DisplayBackupCodes ? (\n              <Button\n                color=\"secondary\"\n                onClick={() => {\n                  onCancel();\n                  resetState();\n                }}>\n                {t(\"cancel\")}\n              </Button>\n            ) : null}\n            <WithStep step={SetupStep.ConfirmPassword} current={step}>\n              <Button\n                type=\"submit\"\n                className=\"me-2 ms-2\"\n                onClick={handleSetup}\n                loading={isSubmitting}\n                disabled={password.length === 0 || isSubmitting}>\n                {t(\"continue\")}\n              </Button>\n            </WithStep>\n            <WithStep step={SetupStep.DisplayQrCode} current={step}>\n              <Button\n                type=\"submit\"\n                data-testid=\"goto-otp-screen\"\n                className=\"me-2 ms-2\"\n                onClick={() => setStep(SetupStep.EnterTotpCode)}>\n                {t(\"continue\")}\n              </Button>\n            </WithStep>\n            <WithStep step={SetupStep.EnterTotpCode} current={step}>\n              <Button\n                type=\"submit\"\n                className=\"me-2 ms-2\"\n                data-testid=\"enable-2fa\"\n                loading={isSubmitting}\n                disabled={isSubmitting}>\n                {t(\"enable\")}\n              </Button>\n            </WithStep>\n            <WithStep step={SetupStep.DisplayBackupCodes} current={step}>\n              <>\n                <Button\n                  color=\"secondary\"\n                  data-testid=\"backup-codes-close\"\n                  onClick={(e) => {\n                    e.preventDefault();\n                    resetState();\n                    onEnable();\n                  }}>\n                  {t(\"close\")}\n              