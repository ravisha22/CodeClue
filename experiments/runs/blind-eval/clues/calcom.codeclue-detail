   const orgSettings = await ctx.prisma.organizationSettings.findUnique({\n      where: {\n        organizationId: ctx.user.organizationId,\n      },\n      select: {\n        lockEventTypeCreationForUsers: true,\n      },\n    });\n\n    const orgHasLockedEventTypes = !!orgSettings?.lockEventTypeCreationForUsers;\n    if (orgHasLockedEventTypes) {\n      console.warn(\n        `User ${userId} does not have permission to create this new event type - Locked status: ${orgHasLockedEventTypes}`\n      );\n      throw new TRPCError({ code: \"UNAUTHORIZED\" });\n    }\n  }\n\n  const profile = ctx.user.profile;\n  try {\n    const eventTypeRepo = new EventTypeRepository(ctx.prisma);\n    const eventType = await eventTypeRepo.create({\n      ...data,\n      profileId: profile.id,\n    });\n    return { eventType };\n  } catch (e) {\n    console.warn(e);\n    if (e instanceof Prisma.PrismaClientKnownRequestError) {\n      if (e.code === \"P2002\" && Array.isArray(e.meta?.target) && e.meta?.target.includes(\"slug\")) {\n        throw new TRPCError({ code: \"BAD_REQUEST\", message: \"URL Slug already exists for given user.\" });\n      }\n    }\n    throw new TRPCError({ code: \"BAD_REQUEST\" });\n  }\n};", "calls": ["PermissionCheckService.checkPermission", "PermissionCheckService.checkPermission", "PermissionCheckService"], "called_by": [], "confidence": 0.86, "purpose": "async_function createHandler", "behavior_patterns": [], "semantic_contract": {"purpose": "async_function createHandler", "language": "typescript", "symbol_name": "createHandler", "symbol_type": "async_function", "signature": "({ ctx, input }: CreateOptions)", "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:packages/trpc/server/routers/viewer/eventTypes/heavy/create.handler.ts:PermissionCheckService.checkPermission:15", "is_external": false}, {"target": "symbol:packages/trpc/server/routers/viewer/eventTypes/heavy/create.handler.ts:PermissionCheckService:12", "is_external": false}], "uses": 