 // TODO: Why don't we parse with schema here? Not doing it makes default() not work in schema.\n      Object.values(keysSchema.keyof()._def.values).reduce(\n        (keysObject, key) => {\n          keys[key as string] = \"\";\n          return keysObject;\n        },\n        {} as Record<string, string>\n      );\n    }\n\n    return {\n      name: app.name,\n      slug: app.slug,\n      logo: app.logo,\n      type: app.type,\n      title: app.title,\n      description: app.description,\n      enabled: dbData?.enabled ?? false,\n      dirName: app.dirName ?? app.slug,\n      keys: Object.keys(keys).length === 0 ? null : keys,\n    };\n  });\n};", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "async_function listLocalHandler", "behavior_patterns": ["PRECEDENCE(dbData -> keysSchema)"], "semantic_contract": {"purpose": "async_function listLocalHandler", "language": "typescript", "symbol_name": "listLocalHandler", "symbol_type": "async_function", "signature": "({ ctx, input }: ListLocalOptions)", "behavior_patterns": ["PRECEDENCE(dbData -> keysSchema)"], "tier": 1, "calls": [], "uses": ["input.category", "prisma.app.findMany", "localApps.flatMap", "app.category", "app.categories", "dbApps.find", "dbApp.slug", "app.slug"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
