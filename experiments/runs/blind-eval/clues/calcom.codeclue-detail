{"node_id": "symbol:packages/features/watchlist/lib/repository/GlobalWatchlistRepository.ts:GlobalWatchlistRepository:11", "symbol": "GlobalWatchlistRepository", "type": "class", "file": "packages/features/watchlist/lib/repository/GlobalWatchlistRepository.ts", "lines": [11, 170], "source": "export class GlobalWatchlistRepository implements IGlobalWatchlistRepository {\n  constructor(private readonly prisma: PrismaClient) {}\n\n  private readonly selectFields = {\n    id: true,\n    type: true,\n    value: true,\n    description: true,\n    isGlobal: true,\n    organizationId: true,\n    action: true,\n    source: true,\n    lastUpdatedAt: true,\n  } as const;\n\n  async findBlockedEmail(email: string): Promise<Watchlist | null> {\n    return this.prisma.watchlist.findFirst({\n      select: this.selectFields,\n      where: {\n        type: WatchlistType.EMAIL,\n        value: email,\n        action: WatchlistAction.BLOCK,\n        organizationId: null,\n        isGlobal: true,\n      },\n    });\n  }\n\n  async findBlockedDomain(domain: string): Promise<Watchlist | null> {\n    return this.prisma.watchlist.findFirst({\n      select: this.selectFields,\n      where: {\n        type: WatchlistType.DOMAIN,\n        value: domain,\n        action: WatchlistAction.BLOCK,\n        organizationId: null,\n        isGlobal: true,\n      },\n    });\n  }\n\n  async findFreeEmailDomain(domain: string): Promise<Watchlist | null> {\n    return this.prisma.watchlist.findFirst({\n      select: this.selectFields,\n      where: {\n        type: WatchlistType.DOMAIN,\n        value: domain,\n        source: WatchlistSource.FREE_DOMAIN_POLICY,\n        organizationId: null,\n        isGlobal: true,\n      },\n    });\n  }\n\n  async findById(id: string): Promise<Watchlist | null> {\n    return this.prisma.watchlist.findFirst({\n      select: this.selectFields,\n      where: {\n        id,\n        organizationId: null,\n        isGlobal: true,\n      },\n    });\n  }\n\n  async listBlockedEntries(): Promise<Watchlist[]> {\n    return this.prisma.watchlist.findMany({\n      select: this.selectFields,\n      where: {\n        organizationId: null,\n        isGlobal: true,\n        action: WatchlistAction.BLOCK,\n      },\n    });\n  }\n\n  /**\n   * Bulk find blocking entries for multiple emails and domains.\n   * Single query for N emails and domains - eliminates N+1.\n   */\n  async findBlockingEntriesForEmailsAndDomains(params: {\n    emails: string[];\n    domains: string[];\n  }): Promise<Watchlist[]> {\n    const { emails, domains } = params;\n\n    if (emails.length === 0 && domains.length === 0) {\n      return [];\n    }\n\n    const conditions: Array<{ type: WatchlistType; value: { in: string[] } }> = [];\n\n    if (emails.length > 0) {\n      conditions.push({ type: WatchlistType.EMAIL, value: { in: emails } });\n    }\n\n    if (domains.length > 0) {\n      conditions.push({ type: WatchlistType.DOMAIN, value: { in: domains } });\n    }\n\n    return this.prisma.watchlist.findMany({\n      select: this.selectFields,\n      where: {\n        organizationId: null,\n        isGlobal: true,\n        action: WatchlistAction.BLOCK,\n        OR: conditions,\n      },\n    });\n  }\n\n  // Write operations for global entries\n  async createEntry(data: {\n    type: WatchlistType;\n    value: string;\n    description?: string | null;\n    action: WatchlistAction;\n    source?: WatchlistSource;\n  }): Promise<Watchlist> {\n    return this.prisma.watchlist.create({\n      select: this.selectFields,\n      data: {\n        type: data.type,\n        value: data.value,\n        description: data.description,\n        isGlobal: true,\n        organizationId: null,\n        action: data.action,\n        source: data.source || WatchlistSource.MANUAL,\n      },\n    });\n  }\n\n  async updateEntry(\n    id: string,\n    data: {\n      value?: string;\n      description?: string | null;\n      action?: WatchlistAction;\n      source?: WatchlistSource;\n    }\n  ): Promise<Watchlist> {\n    return this.prisma.watchlist.update({\n      select: this.selectFields,\n      where: { id },\n      data: {\n        ...(data.value !== undefined && { value: data.value }),\n        ...(data.description !== undefined && { description: data.description }),\n        ...(data.action && { action: data.action }),\n        ...(data.source && { source: data.source }),\n      },\n    });\n  }\n\n  async deleteEntry(id: string): Promise<void> {\n    await this.prisma.watchlist.delete({\n      where: { id },\n    });\n  }\n}", "calls": ["GlobalWatchlistRepository.constructor", "GlobalWatchlistRepository.deleteEntry", "GlobalWatchlistRepository.findBlockedDomain", "GlobalWatchlistRepository.findBlockedEmail", "GlobalWatchlistRepository.findById", "GlobalWatchlistRepository.findFreeEmailDomain", "GlobalWatchlistRepository.listBlockedEntries"], "called_by": [], "confidence": 0.86, "purpose": "class GlobalWatchlistRepository", "behavior_patterns": [], "semantic_contract": {"purpose": "class GlobalWatchlistRepository", "language": "typescript", "symbol_name": "GlobalWatchlistRepository", "symbol_type": "class", "signature": "", "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:packages/features/watchlist/lib/repository/GlobalWatchlistRepository.ts:GlobalWatchlistRepository.constructor:12", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/repository/GlobalWatchlistRepository.ts:GlobalWatchlistRepository.deleteEntry:165", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/repository/GlobalWatchlistRepository.ts:GlobalWatchlistRepository.findBlockedDomain:39", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/repository/GlobalWatchlistRepository.ts:GlobalWatchlistRepository.findBlockedEmail:26", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/repository/GlobalWatchlistRepository.ts:GlobalWatchlistRepository.findById:65", "is_external": f