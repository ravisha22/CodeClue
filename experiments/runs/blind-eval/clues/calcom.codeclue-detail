{"node_id": "symbol:apps/web/app/api/sync/helpscout/route.ts:postHandler:25", "symbol": "postHandler", "type": "async_function", "file": "apps/web/app/api/sync/helpscout/route.ts", "lines": [25, 97], "source": "async function postHandler(request: NextRequest) {\n  const hsSignature = request.headers.get(\"x-helpscout-signature\");\n  if (!hsSignature) return NextResponse.json({ message: \"Missing signature\" }, { status: 400 });\n\n  if (!process.env.CALENDSO_ENCRYPTION_KEY)\n    return NextResponse.json({ message: \"Missing encryption key\" }, { status: 500 });\n\n  const legacyRequest = buildLegacyRequest(await headers(), await cookies());\n\n  // Get the raw request body\n  const rawBody = await getRawBody(legacyRequest);\n\n  try {\n    const parsedBody = helpscoutRequestBodySchema.safeParse(JSON.parse(rawBody.toString()));\n    if (!parsedBody.success) return NextResponse.json({ message: \"Invalid request body\" }, { status: 400 });\n\n    // Verify the signature\n    const calculatedSig = createHmac(\"sha1\", process.env.CALENDSO_ENCRYPTION_KEY)\n      .update(rawBody)\n      .digest(\"base64\");\n\n    if (hsSignature !== calculatedSig)\n      return NextResponse.json({ message: \"Invalid signature\" }, { status: 400 });\n\n    const user = await webPrisma.user.findFirst({\n      where: {\n        email: parsedBody.data.customer.email,\n      },\n      select: {\n        username: true,\n        id: true,\n        createdDate: true,\n      },\n    });\n\n    if (!user) return NextResponse.json({ html: \"User not found\" });\n\n    const lastBooking = await webPrisma.attendee.findFirst({\n      where: {\n        email: parsedBody.data.customer.email,\n      },\n      select: {\n        booking: {\n          select: {\n            createdAt: true,\n          },\n        },\n      },\n      orderBy: {\n        booking: {\n          createdAt: \"desc\",\n        },\n      },\n    });\n\n    return NextResponse.json({\n      html: `\n        <ul>\n          <li><b>Username:</b>&nbsp;${user.username}</li>\n          <li><b>Last booking:</b>&nbsp;${\n            lastBooking && lastBooking.booking\n              ? new Date(lastBooking.booking.createdAt).toLocaleDateString(\"en-US\")\n              : \"No info\"\n          }</li>\n          <li><b>Account created:</b>&nbsp;${new Date(user.createdDate).toLocaleDateString(\"en-US\")}</li>\n        </ul>\n      `,\n    });\n  } catch (error) {\n    console.error(\"Error processing HelpScout request:\", error);\n    return NextResponse.json({ message: \"Internal server error\" }, { status: 500 });\n  }\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "async_function postHandler", "behavior_patterns": [], "semantic_contract": {"purpose": "async_function postHandler", "language": "typescript", "symbol_name": "postHandler", "symbol_type": "async_function", "signature": "(request: NextRequest)", "behavior_patterns": [], "tier": 1, "calls": [], "uses": ["request.headers.get", "NextResponse.json", "process.env.CALENDSO_ENCRYPTION_KEY", "helpscoutRequestBodySchema.safeParse", "JSON.parse", "rawBody.toString", "parsedBody.success", "webPrisma.user.findFirst"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
