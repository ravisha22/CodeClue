n          <tbody className=\"divide-subtle divide-y rounded-md\">\n            {flatData.map((user) => (\n              <Row key={user.email}>\n                <Cell widthClassNames=\"w-auto\">\n                  <div className=\"min-h-10 flex\">\n                    <Avatar\n                      size=\"md\"\n                      alt={`Avatar of ${user.username || \"Nameless\"}`}\n                      imageSrc={`${WEBAPP_URL}/${user.username}/avatar.png`}\n                    />\n                    <div className=\"text-subtle ml-4 font-medium\">\n                      <div className=\"flex gap-3\">\n                        <span className=\"text-default\">{user.name}</span>\n                        <span>/{user.username}</span>\n                        {user.locked && <Badge variant=\"red\">{t(\"locked\")}</Badge>}\n                      </div>\n                      <span className=\"break-all\">{user.email}</span>\n                    </div>\n                  </div>\n                </Cell>\n                <Cell>{user.timeZone}</Cell>\n                <Cell>\n                  <Badge className=\"capitalize\" variant={user.role === \"ADMIN\" ? \"red\" : \"gray\"}>\n                    {user.role.toLowerCase()}\n                  </Badge>\n                </Cell>\n                <Cell widthClassNames=\"w-auto\">\n                  <div className=\"flex w-full justify-end\">\n                    <DropdownActions\n                      actions={[\n                        {\n                          id: \"edit\",\n                          label: t(\"edit\"),\n                          href: `/settings/admin/users/${user.id}/edit`,\n                          icon: \"pencil\" as const,\n                        },\n                        {\n                          id: \"reset-password\",\n                          label: t(\"reset_password\"),\n                          onClick: () => sendPasswordResetEmail.mutate({ userId: user.id }),\n                          icon: \"lock\" as const,\n                        },\n                        {\n                          id: \"lock-user\",\n                          label: user.locked ? t(\"unlock_user_account\") : t(\"lock_user_account\"),\n                          onClick: () => lockUserAccount.mutate({ userId: user.id, locked: !user.locked }),\n                          icon: \"lock\" as const,\n                        },\n                        {\n                          id: \"remove-2fa\",\n                          label: t(\"remove_2fa\"),\n                          color: \"destructive\" as const,\n                          onClick: () => removeTwoFactor.mutate({ userId: user.id }),\n                          icon: \"shield\" as const,\n                        },\n                        {\n                          id: \"delete\",\n                          label: t(\"delete\"),\n                          color: \"destructive\" as const,\n                          onClick: () => setUserToDelete(user.id),\n                          icon: \"trash\" as const,\n                        },\n                      ]}\n                    />\n                  </div>\n                </Cell>\n              </Row>\n            ))}\n          </tbody>\n        </Table>\n        <DeleteUserDialog\n          user={userToDelete}\n          onClose={() => setUserToDelete(null)}\n          onConfirm={() => {\n            if (!userToDelete) return;\n            deleteMutation.mutate({ userId: userToDelete });\n          }}\n        />\n      </div>\n    </div>\n  );\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "function UsersTable", "behavior_patterns": ["PRECEDENCE(not_cachedData -> containerRefElement -> scrollHeight)", "TRANSFORM(map)"], "semantic_contract": {"purpose": "function UsersTable", "language": "typescript", "symbol_name": "UsersTable", "symbol_type": "function", "signature": "()", "behavior_patterns": ["PRECEDENCE(not_cachedData -> containerR