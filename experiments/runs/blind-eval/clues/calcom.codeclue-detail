ader title={t(\"additional_guests\")} />\n            <div className=\"bg-default\">\n              <MultiEmail\n                label={t(\"add_emails\")}\n                value={multiEmailValue}\n                readOnly={false}\n                setValue={setMultiEmailValue}\n              />\n            </div>\n\n            {isInvalidEmail && (\n              <div className=\"my-4 flex text-sm text-red-700\">\n                <div className=\"shrink-0\">\n                  <TriangleAlertIcon className=\"h-5 w-5\" />\n                </div>\n                <div className=\"ml-3\">\n                  <p className=\"font-medium\">{t(\"emails_must_be_unique_valid\")}</p>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n        <DialogFooter showDivider className=\"mt-8\">\n          <Button\n            onClick={() => {\n              setMultiEmailValue([\"\"]);\n              setIsInvalidEmail(false);\n              setIsOpenDialog(false);\n            }}\n            type=\"button\"\n            color=\"secondary\">\n            {t(\"cancel\")}\n          </Button>\n          <Button data-testid=\"add_members\" loading={addGuestsMutation.isPending} onClick={handleAdd}>\n            {t(\"add\")}\n          </Button>\n        </DialogFooter>\n      </DialogContent>\n    </Dialog>\n  );\n};", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "function AddGuestsDialog", "behavior_patterns": ["GUARD(multiEmailValue.length === 0 -> return;)", "PRECEDENCE(multiEmailValue -> validationResult -> default)", "TRANSFORM(map)"], "semantic_contract": {"purpose": "function AddGuestsDialog", "language": "typescript", "symbol_name": "AddGuestsDialog", "symbol_type": "function", "signature": "(props: IAddGuestsDialog)", "behavior_patterns": ["GUARD(multiEmailValue.length === 0 -> return;)", "PRECEDENCE(multiEmailValue -> validationResult -> default)", "TRANSFORM(map)"], "tier": 1, "calls": [], "uses": ["z.array", "z.string