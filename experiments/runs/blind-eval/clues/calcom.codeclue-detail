ate first admin user\n    return {\n      redirect: {\n        destination: \"/auth/setup\",\n        permanent: false,\n      },\n    };\n  }\n  return {\n    props: {\n      csrfToken: await getCsrfToken(context),\n      isGoogleLoginEnabled: IS_GOOGLE_LOGIN_ENABLED,\n      isOutlookLoginEnabled: false,\n      totpEmail,\n    },\n  };\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "async_function getServerSideProps", "behavior_patterns": ["PRECEDENCE(context -> decryptedJwt -> session -> default)"], "semantic_contract": {"purpose": "async_function getServerSideProps", "language": "typescript", "symbol_name": "getServerSideProps", "symbol_type": "async_function", "signature": "(context: GetServerSidePropsContext)", "behavior_patterns": ["PRECEDENCE(context -> decryptedJwt -> session -> default)"], "tier": 1, "calls": [], "uses": ["process.env.CALENDSO_ENCRYPTION_KEY", "context.query.totp", "decryptedJwt.payload", "decryptedJwt.payload.email", "console.warn", "prisma.user.findFirst"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
