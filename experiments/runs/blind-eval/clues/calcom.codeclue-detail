rategy"], "confidence": 0.86, "purpose": "async_method ApiAuthStrategy.accessTokenStrategy", "behavior_patterns": [], "semantic_contract": {"purpose": "async_method ApiAuthStrategy.accessTokenStrategy", "language": "typescript", "symbol_name": "ApiAuthStrategy.accessTokenStrategy", "symbol_type": "async_method", "signature": "(accessToken: string, request: ApiAuthGuardRequest, origin...)", "behavior_patterns": [], "tier": 1, "calls": [], "uses": ["this.oauthFlowService.validateAccessToken", "this.tokensRepository.getAccessTokenClient", "client.redirectUris", "app.cal.com", "client.id", "this.tokensRepository.getAccessTokenOwnerId", "this.userRepository.findByIdWithProfile", "this.usersService.getUserMainOrgId"], "called_by": [{"source": "symbol:apps/api/v2/src/modules/auth/strategies/api-auth/api-auth.strategy.ts:ApiAuthStrategy:38"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
