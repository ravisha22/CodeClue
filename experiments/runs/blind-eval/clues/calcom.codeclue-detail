{"node_id": "symbol:apps/web/playwright/booking-phone-autofill.e2e.ts:fillPhoneLocationInput:166", "symbol": "fillPhoneLocationInput", "type": "async_function", "file": "apps/web/playwright/booking-phone-autofill.e2e.ts", "lines": [166, 193], "source": "\nasync function fillPhoneLocationInput(page: Page, phoneNumber: string) {\n  // The location field has a phone input when \"Attendee Phone Number\" is selected\n  await page.waitForSelector(`[data-fob-field-name=\"location\"] input`);\n  const locationInput = page.locator(`[data-fob-field-name=\"location\"] input`);\n\n  // Ensure the field is empty first\n  await locationInput.clear();\n  // Wait for mask/prefix to settle (empty string, just \"+\", or country prefix)\n  await expect.poll(async () => locationInput.inputValue()).toMatch(/^(?:|\\+|\\+\\d{1,3})$/);\n\n  // If the mask auto-inserts a country prefix (or just \"+\"), avoid duplicating it\n  const prefill = await locationInput.inputValue();\n  let toType = phoneNumber;\n  if (prefill === \"+\" && phoneNumber.startsWith(\"+\")) {\n    // If field has just \"+\", type the rest without the \"+\"\n    toType = phoneNumber.slice(1);\n  } else if (/^\\+\\d{1,3}$/.test(prefill) && phoneNumber.startsWith(prefill)) {\n    // If field has a country prefix like \"+1\", type the rest\n    toType = phoneNumber.slice(prefill.length);\n  }\n\n  // Type the phone number with a small delay to play nicely with masking\n  await locationInput.pressSequentially(toType, { delay: 20 });\n\n  // Trigger blur to ensure the auto-fill effect runs\n  await page.locator('[name=\"name\"]').click();\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "async_function fillPhoneLocationInput", "behavior_patterns": [], "semantic_contract": {"purpose": "async_function fillPhoneLocationInput", "language": "typescript", "symbol_name": "fillPhoneLocationInput", "symbol_type": "async_function", "signature": "(page: Page, phoneNumber: string)", "behavior_patterns": [], "tier": 1, "c