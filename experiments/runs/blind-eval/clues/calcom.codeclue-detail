k) {\n      headers[\"X-Cal-Signature-256\"] = createWebhookSignature({ secret: webhook.secret, body: job.payload });\n    }\n    fetchPromises.push(\n      fetch(job.subscriberUrl, {\n        method: \"POST\",\n        body: job.payload,\n        headers,\n        // Avoid following redirect\n        redirect: \"manual\",\n      }).catch((error) => {\n        console.error(`Webhook trigger for subscriber url ${job.subscriberUrl} failed with error: ${error}`);\n      })\n    );\n\n    // clean finished job\n    await prisma.webhookScheduledTriggers.delete({\n      where: {\n        id: job.id,\n      },\n    });\n  }\n\n  Promise.allSettled(fetchPromises);\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "async_function handleWebhookScheduledTriggers", "behavior_patterns": ["ACCUMULATE(handleWebhookSchedule... -> result)"], "semantic_contract": {"purpose": "async_function handleWebhookScheduledTriggers", "language": "typescript", "symbol_name": "handleWebhookScheduledTriggers", "symbol_type": "async_function", "signature": "(prisma: PrismaClient)", "behavior_patterns": ["ACCUMULATE(handleWebhookSchedule... -> result)"], "tier": 1, "calls": [], "uses": ["prisma.webhookScheduledTriggers.deleteMany", "prisma.webhookScheduledTriggers.findMany", "job.webhook", "job.jobName", "job.jobName.split", "prisma.webhook.findUniqueOrThrow", "logger.error", "job.payload"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
