iryDate = Math.round(Date.now() + tokenInfo.data.expires_in);\n  tokenInfo.data.accountServer = accountsServer;\n\n  await createOAuthAppCredential({ appId: appConfig.slug, type: appConfig.type }, tokenInfo.data, req);\n\n  res.redirect(\n    getSafeRedirectUrl(state?.returnTo) ??\n      getInstalledAppPath({ variant: appConfig.variant, slug: appConfig.slug })\n  );\n}", "calls": ["isAuthorizedAccountsServerUrl"], "called_by": [], "confidence": 0.86, "purpose": "async_function handler", "behavior_patterns": ["PRECEDENCE(code -> not_accountsServer -> not_req)"], "semantic_contract": {"purpose": "async_function handler", "language": "typescript", "symbol_name": "handler", "symbol_type": "async_function", "signature": "(req: NextApiRequest, res: NextApiResponse)", "behavior_patterns": ["PRECEDENCE(code -> not_accountsServer -> not_req)"], "tier": 1, "calls": [{"target": "symbol:packages/app-store/zoho-bigin/api/callback.ts:isAuthorizedAccountsServerUrl:13", "is_external": false}], "uses": ["req.query", "res.status", "req.session", "appConfig.slug", "appKeys.client_id", "appKeys.client_secret", "axios.post", "qs.stringify"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
