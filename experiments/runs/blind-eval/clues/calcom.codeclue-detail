ent.booking.eventType.slug}`;\n    return res.redirect(url);\n  }\n\n  const parsedData = PaymentDataSchema.parse(payment.data);\n  const queryParams = {\n    \"flag.coep\": false,\n    isSuccessBookingPage: true,\n    email: parsedData.email,\n    eventTypeSlug: payment.booking.eventType.slug,\n  };\n\n  const query = qs.stringify(queryParams);\n  const url = `/booking/${payment.booking.uid}?${query}`;\n\n  return res.redirect(url);\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "async_function handler", "behavior_patterns": ["PRECEDENCE(not_reference -> not_payment -> not_key)"], "semantic_contract": {"purpose": "async_function handler", "language": "typescript", "symbol_name": "handler", "symbol_type": "async_function", "signature": "(req: NextApiRequest, res: NextApiResponse)", "behavior_patterns": ["PRECEDENCE(not_reference -> not_payment -> not_key)"], "tier": 1, "calls": [], "uses": ["req.query", "prisma.payment.findFirst", "prisma.credential.findFirst", "payment.booking", "payment.booking.eventType.teamId", "payment.booking.user", "payment.booking.eventType", "prisma.booking.update"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
