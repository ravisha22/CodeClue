eturn next();\n  });\n};", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "function createWebhookProcedure", "behavior_patterns": ["PRECEDENCE(lookupId -> not_webhook -> eventTypeId)"], "semantic_contract": {"purpose": "function createWebhookProcedure", "language": "typescript", "symbol_name": "createWebhookProcedure", "symbol_type": "function", "signature": "()", "behavior_patterns": ["PRECEDENCE(lookupId -> not_webhook -> eventTypeId)"], "tier": 1, "calls": [], "uses": ["authedProcedure.input", "webhookIdAndEventTypeIdSchema.optional", "prisma.webhook.findUnique", "webhook.eventTypeId", "prisma.eventType.findUnique", "eventType.userId", "ctx.user.id", "webhook.userId"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
