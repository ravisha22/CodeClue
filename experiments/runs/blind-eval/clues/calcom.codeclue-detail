\"select_team_member\")}\n                enterEmailPlaceholder={t(\"enter_email\")}\n              />\n\n              <AdditionalNotesSection\n                control={control}\n                additionalNotesLabel={t(\"additional_notes\")}\n                placeholder={t(\"wrong_assignment_notes_placeholder\")}\n                fieldRequiredText={t(\"field_required\")}\n                errorMessage={errors.additionalNotes?.message}\n              />\n\n              {alreadyReported && (\n                <Alert severity=\"warning\" message={t(\"wrong_assignment_already_reported\")} className=\"mb-4\" />\n              )}\n\n              <Alert severity=\"info\" title={t(\"did_you_know\")} message={t(\"wrong_assignment_crm_info\")} />\n            </div>\n          </div>\n\n          <DialogFooter showDivider className=\"mt-8\">\n            <Button type=\"button\" color=\"secondary\" onClick={handleCloseClick} disabled={isPending}>\n              {t(\"close\")}\n            </Button>\n            <Button\n              type=\"submit\"\n              color=\"primary\"\n              disabled={isPending || alreadyReported || isCheckingReport}\n              loading={isPending || isCheckingReport}>\n              {t(\"submit\")}\n            </Button>\n          </DialogFooter>\n        </form>\n      </DialogContent>\n    </Dialog>\n  );\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "function WrongAssignmentDialog", "behavior_patterns": ["TRANSFORM(map)"], "semantic_contract": {"purpose": "function WrongAssignmentDialog", "language": "typescript", "symbol_name": "WrongAssignmentDialog", "symbol_type": "function", "signature": "(props: IWrongAssignmentDialog)", "behavior_patterns": ["TRANSFORM(map)"], "tier": 1, "calls": [], "uses": ["JSX.Element", "trpc.useUtils", "booking.uid", "booking.eventType", "booking.assignmentReasonSortedByCreatedAt", "booking.attendees", "booking.user", "trpc.viewer.bookings.hasWrongAssignmentReport.useQuery"], "call