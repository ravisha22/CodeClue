{"node_id": "symbol:packages/features/watchlist/lib/service/WatchlistService.ts:WatchlistService:17", "symbol": "WatchlistService", "type": "class", "file": "packages/features/watchlist/lib/service/WatchlistService.ts", "lines": [17, 87], "source": "\nexport class WatchlistService implements IWatchlistService {\n  private readonly log: ReturnType<typeof logger.getSubLogger>;\n\n  constructor(private readonly deps: Deps) {\n    this.log = deps.logger;\n  }\n\n  async createEntry(data: CreateWatchlistEntryData): Promise<WatchlistEntry> {\n    const isGlobal = data.isGlobal ?? false;\n\n    // Normalize value based on type (service layer responsibility)\n    const normalizedValue =\n      data.type === WatchlistType.EMAIL ? normalizeEmail(data.value) : normalizeDomain(data.value);\n\n    const payload = {\n      type: data.type,\n      value: normalizedValue,\n      description: data.description,\n      action: data.action,\n      source: data.source,\n    };\n\n    // Global path\n    if (isGlobal) {\n      return this.deps.globalRepo.createEntry(payload);\n    }\n\n    // Org path (validate, then narrow)\n    const orgId = data.organizationId;\n    if (orgId == null) {\n      this.log.error(\"organizationId required for non-global entry\", { type: data.type, value: data.value });\n      throw new Error(\"organizationId is required for organization-scoped entries\");\n    }\n\n    return this.deps.orgRepo.createEntry(orgId, payload);\n  }\n\n  async updateEntry(id: string, data: UpdateWatchlistEntryData): Promise<WatchlistEntry> {\n    // Normalize value if provided (service layer responsibility)\n    const payload = {\n      ...data,\n      ...(data.value && {\n        value: data.type === WatchlistType.EMAIL ? normalizeEmail(data.value) : normalizeDomain(data.value),\n      }),\n    };\n\n    return this.deps.globalRepo.updateEntry(id, payload);\n  }\n\n  async deleteEntry(id: string): Promise<void> {\n    return this.deps.globalRepo.deleteEntry(id);\n  }\n\n  async getEntry(id: string): Promise<WatchlistEntry | null> {\n    return this.deps.globalRepo.findById(id);\n  }\n\n  /**\n   * System admin method to get ALL watchlist entries across the entire system\n   * Returns both global entries and all organization-specific entries from every organization\n   */\n  async listAllSystemEntries(): Promise<WatchlistEntry[]> {\n    const [globalEntries, allOrgEntries] = await Promise.all([\n      this.deps.globalRepo.listBlockedEntries(),\n      this.deps.orgRepo.listAllOrganizationEntries(),\n    ]);\n\n    return [...globalEntries, ...allOrgEntries];\n  }\n}", "calls": ["WatchlistService.constructor", "WatchlistService.createEntry", "WatchlistService.createEntry", "WatchlistService.createEntry", "WatchlistService.deleteEntry", "WatchlistService.deleteEntry", "WatchlistService.getEntry", "WatchlistService.listAllSystemEntries", "WatchlistService.updateEntry", "WatchlistService.updateEntry"], "called_by": [], "confidence": 0.86, "purpose": "class WatchlistService", "behavior_patterns": [], "semantic_contract": {"purpose": "class WatchlistService", "language": "typescript", "symbol_name": "WatchlistService", "symbol_type": "class", "signature": "", "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:packages/features/watchlist/lib/service/WatchlistService.ts:WatchlistService.constructor:21", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/service/WatchlistService.ts:WatchlistService.createEntry:25", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/service/WatchlistService.ts:WatchlistService.deleteEntry:67", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/service/WatchlistService.ts:WatchlistService.getEntry:71", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/service/WatchlistService.ts:WatchlistService.listAllSystemEntries:79", "is_external": false}, {"target": "symbol:packages/features/watchlist/lib/service/WatchlistSe