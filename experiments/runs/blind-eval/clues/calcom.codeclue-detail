rver Error\", error: error.message });\n  }\n}", "calls": [], "called_by": [], "confidence": 0.86, "purpose": "async_function handler", "behavior_patterns": ["PRECEDENCE(appSlug -> not_accessToken -> default)"], "semantic_contract": {"purpose": "async_function handler", "language": "typescript", "symbol_name": "handler", "symbol_type": "async_function", "signature": "(req: NextApiRequest, res)", "behavior_patterns": ["PRECEDENCE(appSlug -> not_accessToken -> default)"], "tier": 1, "calls": [], "uses": ["req.query.invalid", "req.query.userId", "req.query.appSlug", "res.status", "JSON.stringify", "result.clone", "result.ok", "result.json"], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
