{"symbol":"_interpret_color","type":"function","file":"src/click/termui.py","lines":[507,515],"source":"def _interpret_color(color: int | tuple[int, int, int] | str, offset: int = 0) -> str:\n    if isinstance(color, int):\n        return f\"{38 + offset};5;{color:d}\"\n\n    if isinstance(color, (tuple, list)):\n        r, g, b = color\n        return f\"{38 + offset};2;{r:d};{g:d};{b:d}\"\n\n    return str(_ansi_colors[color] + offset)","calls":[],"called_by":["style","style"],"confidence":0.92,"purpose":"function _interpret_color"}
