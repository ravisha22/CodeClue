ame=device.name).annotate_config_context_data()\n        self.assertEqual(ConfigContext.objects.get_for_object(device).count(), 2)\n        self.assertEqual(device.get_config_context(), annotated_queryset[0].get_config_context())\n\n    @tag('performance', 'regression')", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Tagged items use a generic relationship, which results in duplicate rows being returned when queried.", "behavior_patterns": [], "semantic_contract": {"purpose": "Tagged items use a generic relationship, which results in duplicate rows being returned when queried.", "language": "python", "symbol_name": "test_multiple_tags_return_distinct_objects_with_separate_config_contexts", "symbol_type": "function", "signature": "()", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
