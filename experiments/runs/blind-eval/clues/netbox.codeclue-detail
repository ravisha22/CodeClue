            },\n            {\n                'a_terminations': [{\n                    'object_type': 'dcim.interface',\n                    'object_id': interfaces[5].pk,\n                }],\n                'b_terminations': [{\n                    'object_type': 'dcim.interface',\n                    'object_id': interfaces[15].pk,\n                }],\n                'label': 'Cable 5',\n                'profile': CableProfileChoices.SINGLE_1C1P,\n            },\n            {\n                'a_terminations': [{\n                    'object_type': 'dcim.interface',\n                    'object_id': interfaces[6].pk,\n                }],\n                'b_terminations': [{\n                    'object_type': 'dcim.interface',\n                    'object_id': interfaces[16].pk,\n                }],\n                'label': 'Cable 6',\n                # No profile (legacy behavior)\n            },\n        ]", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "function setUpTestData", "behavior_patterns": ["ACCUMULATE(devices loop -> interfaces Interface)"], "semantic_contract": {"purpose": "function setUpTestData", "language": "python", "symbol_name": "setUpTestData", "symbol_type": "function", "signature": "(cls)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["ACCUMULATE(devices loop -> interfaces Interface)"], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
