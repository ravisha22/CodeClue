{"node_id": "symbol:netbox/utilities/data.py:string_to_ranges:200", "symbol": "string_to_ranges", "type": "function", "file": "netbox/utilities/data.py", "lines": [200, 230], "source": "def string_to_ranges(value):\n    \"\"\"\n    Converts a string representation of numeric ranges into a list of NumericRange objects.\n\n    This function parses a string containing numeric values and ranges separated by commas (e.g.,\n    \"1-5,8,10-12\") and converts it into a list of NumericRange objects.\n    In the case of a single integer, it is treated as a range where the start and end\n    are equal. The returned ranges are represented as half-open intervals [lower, upper).\n    Intended for use with ArrayField.\n\n    Example:\n        \"1-5,8,10-12\" => [NumericRange(1, 6), NumericRange(8, 9), NumericRange(10, 13)]\n    \"\"\"\n    if not value:\n        return None\n    value.replace(' ', '')  # Remove whitespace\n    values = []\n    for data in value.split(','):\n        dash_range = data.strip().split('-')\n        if len(dash_range) == 1 and str(dash_range[0]).isdigit():\n            # Single integer value; expand to a range\n            lower = dash_range[0]\n            upper = dash_range[0]\n        elif len(dash_range) == 2 and str(dash_range[0]).isdigit() and str(dash_range[1]).isdigit():\n            # The range has two values and both are valid integers\n            lower = dash_range[0]\n            upper = dash_range[1]\n        else:\n            return None\n        values.append(NumericRange(int(lower), int(upper) + 1, bounds='[)'))\n    return values", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Converts a string representation of numeric ranges into a list of NumericRange objects.", "behavior_patterns": ["ACCUMULATE(value.split(',') loop -> values NumericRange)"], "semantic_contract": {"purpose": "Converts a string representation of numeric ranges into a list of NumericRange objects.", "language": "python", "symbol_name": "string_to_ranges", "symbol_type": "function", "signature": "(value)", "bases": [], "class_attrs": {}, "raises": [], "uses": ["NumericRange (django.db.backends.postgresql.psycopg_any)"], "behavior_patterns": ["ACCUMULATE(value.split(',') loop -> values NumericRange)"], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
