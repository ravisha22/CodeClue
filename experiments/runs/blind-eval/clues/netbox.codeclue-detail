ild interfaces\n        child_interfaces = VMInterface.objects.restrict(request.user, 'view').filter(parent=instance)\n        child_interfaces_tables = tables.VMInterfaceTable(\n            child_interfaces,\n            exclude=('virtual_machine',),\n            orderable=False\n        )\n        child_interfaces_tables.configure(request)\n\n        # Get VLAN translation rules\n        vlan_translation_table = None\n        if instance.vlan_translation_policy:\n            vlan_translation_table = VLANTranslationRuleTable(\n                data=instance.vlan_translation_policy.rules.all(),\n                orderable=False\n            )\n            vlan_translation_table.configure(request)\n\n        return {\n            'child_interfaces_table': child_interfaces_tables,\n            'vlan_translation_table': vlan_translation_table,\n        }", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "class VMInterfaceView", "behavior_patterns": [], "semantic_contract": {"purpose": "class VMInterfaceView", "language": "python", "symbol_name": "VMInterfaceView", "symbol_type": "class", "signature": "", "bases": ["ObjectView"], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
