{"node_id": "symbol:netbox/utilities/views.py:TokenConditionalLoginRequiredMixin:51", "symbol": "TokenConditionalLoginRequiredMixin", "type": "class", "file": "netbox/utilities/views.py", "lines": [51, 63], "source": "class TokenConditionalLoginRequiredMixin(ConditionalLoginRequiredMixin):\n    def dispatch(self, request, *args, **kwargs):\n        # Attempt to authenticate the user using a DRF token, if provided\n        if settings.LOGIN_REQUIRED and not request.user.is_authenticated:\n            authenticator = TokenAuthentication()\n            try:\n                if (auth_info := authenticator.authenticate(request)) is not None:\n                    request.user = auth_info[0]  # User object\n                    request.auth = auth_info[1]\n            except AuthenticationFailed:\n                return HttpResponseForbidden(\"Invalid token\")\n\n        return super().dispatch(request, *args, **kwargs)", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "class TokenConditionalLoginRequiredMixin", "behavior_patterns": [], "semantic_contract": {"purpose": "class TokenConditionalLoginRequiredMixin", "language": "python", "symbol_name": "TokenConditionalLoginRequiredMixin", "symbol_type": "class", "signature": "", "bases": ["ConditionalLoginRequiredMixin"], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
