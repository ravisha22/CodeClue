ields'):\n            for field in self.custom_fields:\n                if field.is_cloneable:\n                    attrs[f'cf_{field.name}'] = self.custom_field_data.get(field.name)\n\n        return attrs", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Returns a dictionary of attributes suitable for creating a copy of the current instance.", "behavior_patterns": ["ACCUMULATE(getattr(self, 'clone_... -> result)"], "semantic_contract": {"purpose": "Returns a dictionary of attributes suitable for creating a copy of the current instance.", "language": "python", "symbol_name": "clone", "symbol_type": "function", "signature": "()", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["ACCUMULATE(getattr(self, 'clone_... -> result)"], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
