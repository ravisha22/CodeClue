Instantiate the model form for the object\n            model_form_kwargs = {\n                'data': record,\n                'instance': instance,\n            }\n            if hasattr(form, '_csv_headers'):\n                model_form_kwargs['headers'] = form._csv_headers  # Add CSV headers\n            model_form = self.model_form(**model_form_kwargs)\n\n            # When updating, omit all form fields other than those specified in the record. (No\n            # fields are required when modifying an existing object.)\n            if object_id:\n                unused_fields = [f for f in model_form.fields if f not in record]\n                for field_name in unused_fields:\n                    del model_form.fields[field_name]\n\n            restrict_form_fields(model_form, request.user)\n\n            if model_form.is_valid():\n                obj = self._save_object(model_form, request, i)\n                saved_objects.append(obj)\n            else:\n                # Raise model form errors\n                raise ValidationError(\n                    self._compile_form_errors(model_form.errors, index=i)\n                )\n\n        return saved_objects", "calls": ["_compile_form_errors", "_compile_form_errors", "_save_object"], "called_by": ["create_and_update_objects", "create_and_update_objects", "BulkImportView", "BulkImportView"], "confidence": 0.92, "purpose": "Process CSV import records and save objects.", "behavior_patterns": ["ACCUMULATE(enumerate(records, st... -> saved objects obj, raises ValidationE...)"], "semantic_contract": {"purpose": "Process CSV import records and save objects.", "language": "python", "symbol_name": "_process_import_records", "symbol_type": "function", "signature": "(form, request, records, prefetched_objects)", "bases": [], "class_attrs": {}, "raises": ["ValidationError"], "uses": ["ValidationError (django.core.exceptions)"], "behavior_patterns": ["ACCUMULATE(enumerate(records, st... -> saved objects obj, raises Validat