tions', None)\n\n        return attrs", "calls": [], "called_by": ["Cable"], "confidence": 0.92, "purpose": "Return attributes suitable for cloning this cable.", "behavior_patterns": ["ACCUMULATE((('a', self.a_termina... -> result)"], "semantic_contract": {"purpose": "Return attributes suitable for cloning this cable.", "language": "python", "symbol_name": "clone", "symbol_type": "function", "signature": "()", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["ACCUMULATE((('a', self.a_termina... -> result)"], "tier": 1, "calls": [], "called_by": [{"source": "symbol:netbox/dcim/models/cables.py:Cable:45"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
