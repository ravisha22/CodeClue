': 'Test VLAN 100',\n            'site': {\n                'name': 'Site 1'\n            },\n        }\n        url = reverse('ipam-api:vlan-list')\n        self.add_permissions('ipam.add_vlan')\n\n        response = self.client.post(url, data, format='json', **self.header)\n        self.assertHttpStatus(response, status.HTTP_201_CREATED)\n        self.assertEqual(response.data['site']['id'], self.site1.pk)\n        vlan = VLAN.objects.get(pk=response.data['id'])\n        self.assertEqual(vlan.site, self.site1)\n\n    def test_related_by_attributes_no_match(self):\n        data = {\n            'vid': 100,\n            'name': 'Test VLAN 100',\n            'site': {\n                'name': 'Site X'\n            },\n        }\n        url = reverse('ipam-api:vlan-list')\n        self.add_permissions('ipam.add_vlan')\n\n        with disable_warnings('django.request'):\n            response = self.client.post(url, data, format='json', **self.header)\n        self.assertHttpStatus(response, status.HTTP_400_BAD_REQUEST)\n        self.assertEqual(VLAN.objects.count(), 0)\n        self.assertTrue(response.data['site'][0].startswith(\"Related object not found\"))\n\n    def test_related_by_attributes_multiple_matches(self):\n        data = {\n            'vid': 100,\n            'name': 'Test VLAN 100',\n            'site': {\n                'region': {\n                    \"name\": \"Region A\",\n                },\n            },\n        }\n        url = reverse('ipam-api:vlan-list')\n        self.add_permissions('ipam.add_vlan')\n\n        with disable_warnings('django.request'):\n            response = self.client.post(url, data, format='json', **self.header)\n        self.assertHttpStatus(response, status.HTTP_400_BAD_REQUEST)\n        self.assertEqual(VLAN.objects.count(), 0)\n        self.assertTrue(response.data['site'][0].startswith(\"Multiple objects match\"))\n\n    def test_related_by_invalid(self):\n        data = {\n            'vid': 100,\n            'name': 'Test VLAN 100',\n            'site': 'XXX',\n        }\n        url = reverse('ipam-api:vlan-list')\n        self.add_permissions('ipam.add_vlan')\n\n        with disable_warnings('django.request'):\n            response = self.client.post(url, data, format='json', **self.header)\n        self.assertHttpStatus(response, status.HTTP_400_BAD_REQUEST)\n        self.assertEqual(VLAN.objects.count(), 0)", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Test the operation of WritableNestedSerializer using VLANSerializer as our test subject.", "behavior_patterns": [], "semantic_contract": {"purpose": "Test the operation of WritableNestedSerializer using VLANSerializer as our test subject.", "language": "python", "symbol_name": "WritableNestedSerializerTest", "symbol_type": "class", "signature": "", "bases": ["APITestCase"], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
