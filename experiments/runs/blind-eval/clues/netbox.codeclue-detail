s(\n            (interface2, cable2, circuittermination2, circuittermination1, cable1, interface1),\n            is_complete=True,\n            is_active=True\n        )\n        self.assertEqual(CablePath.objects.count(), 2)\n\n        # Test SVG generation\n        CableTraceSVG(interface1).render()\n\n        # Delete cable 2\n        cable2.delete()\n        path1 = self.assertPathExists(\n            (interface1, cable1, circuittermination1, circuittermination2, self.site),\n            is_active=True\n        )\n        self.assertEqual(CablePath.objects.count(), 1)\n        interface1.refresh_from_db()\n        interface2.refresh_from_db()\n        self.assertPathIsSet(interface1, path1)\n        self.assertPathIsNotSet(interface2)", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "[IF1] --C1-- [CT1] [CT2] --C2-- [IF2]", "behavior_patterns": [], "semantic_contract": {"purpose": "[IF1] --C1-- [CT1] [CT2] --C2-- [IF2]", "language": "python", "symbol_name": "test_211_interface_to_interface_via_circuit", "symbol_type": "function", "signature": "()", "bases": [], "class_attrs": {}, "raises": [], "uses": ["CableTraceSVG (dcim.svg)"], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
