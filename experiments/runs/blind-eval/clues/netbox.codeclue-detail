{"node_id": "symbol:netbox/utilities/choices.py:ChoiceSetMeta:15", "symbol": "ChoiceSetMeta", "type": "class", "file": "netbox/utilities/choices.py", "lines": [15, 60], "source": "class ChoiceSetMeta(type):\n    \"\"\"\n    Metaclass for ChoiceSet\n    \"\"\"\n    def __new__(mcs, name, bases, attrs):\n\n        # Extend static choices with any configured choices\n        if key := attrs.get('key'):\n            assert type(attrs['CHOICES']) is list, _(\n                \"{name} has a key defined but CHOICES is not a list\"\n            ).format(name=name)\n            app = attrs['__module__'].split('.', 1)[0]\n            replace_key = f'{app}.{key}'\n            replace_choices = get_config_value_ci(settings.FIELD_CHOICES, replace_key)\n            if replace_choices is not None:\n                attrs['CHOICES'] = replace_choices\n            else:\n                extend_key = f'{replace_key}+'\n                extend_choices = get_config_value_ci(settings.FIELD_CHOICES, extend_key)\n                if extend_choices is not None:\n                    attrs['CHOICES'].extend(extend_choices)\n\n        # Define choice tuples and color maps\n        attrs['_choices'] = []\n        attrs['colors'] = {}\n        for choice in attrs['CHOICES']:\n            if isinstance(choice[1], (list, tuple)):\n                grouped_choices = []\n                for c in choice[1]:\n                    grouped_choices.append((c[0], c[1]))\n                    if len(c) == 3:\n                        attrs['colors'][c[0]] = c[2]\n                attrs['_choices'].append((choice[0], grouped_choices))\n            else:\n                attrs['_choices'].append((choice[0], choice[1]))\n                if len(choice) == 3:\n                    attrs['colors'][choice[0]] = choice[2]\n\n        return super().__new__(mcs, name, bases, attrs)\n\n    def __call__(cls, *args, **kwargs):\n        # django-filters will check if a 'choices' value is callable, and if so assume that it returns an iterable\n        return getattr(cls, '_choices', ())\n\n    def __iter__(cls):\n        return iter(getattr(cls, '_choices', ()))", "calls": ["__new__"], "called_by": [], "confidence": 0.92, "purpose": "Metaclass for ChoiceSet", "behavior_patterns": [], "semantic_contract": {"purpose": "Metaclass for ChoiceSet", "language": "python", "symbol_name": "ChoiceSetMeta", "symbol_type": "class", "signature": "", "bases": ["type"], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:netbox/utilities/choices.py:ChoiceSetMeta.__new__:19", "is_external": false}], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/utilities/choices.py:unpack_grouped_choices:86", "symbol": "unpack_grouped_choices", "type": "function", "file": "netbox/utilities/choices.py", "lines": [86, 118], "source": "def unpack_grouped_choices(choices):\n    \"\"\"\n    Unpack a grouped choices hierarchy into a flat list of two-tuples. For example:\n\n    choices = (\n        ('Foo', (\n            (1, 'A'),\n            (2, 'B')\n        )),\n        ('Bar', (\n            (3, 'C'),\n            (4, 'D')\n        ))\n    )\n\n    becomes:\n\n    choices = (\n        (1, 'A'),\n        (2, 'B'),\n        (3, 'C'),\n        (4, 'D')\n    )\n    \"\"\"\n    unpacked_choices = []\n    for key, value in choices:\n        if isinstance(value, (list, tuple)):\n            # Entered an optgroup\n            for optgroup_key, optgroup_value in value:\n                unpacked_choices.append((optgroup_key, optgroup_value))\n        else:\n            unpacked_choices.append((key, value))\n    return unpacked_choices", "calls": [], "called_by": ["values", "ChoiceSet"], "confidence": 0.92, "purpose": "Unpack a grouped choices hierarchy into a flat list of two-tuples.", "behavior_patterns": ["ACCUMULATE(choices loop -> unpacked choices value)"], "semantic_contract": {"purpose": "Unpack a grouped choices hierarchy into a flat list of two-tuples.", "language": "python", "symbol_name": "unpack_grouped_choices", "symbol_type": "function", "signature": "(choices)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["ACCUMULATE(choices loop -> unpacked choices value)"], "tier": 1, "calls": [], "called_by": [{"source": "symbol:netbox/utilities/choices.py:ChoiceSet.values:71"}, {"source": "symbol:netbox/utilities/choices.py:ChoiceSet:63"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/utilities/conversion.py:to_grams:14", "symbol": "to_grams", "type": "function", "file": "netbox/utilities/conversion.py", "lines": [14, 37], "source": "def to_grams(weight, unit) -> int:\n    \"\"\"\n    Convert the given weight to integer grams.\n    \"\"\"\n    try:\n        if weight < 0:\n            raise ValueError(_(\"Weight must be a positive number\"))\n    except TypeError:\n        raise TypeError(_(\"Invalid value '{weight}' for weight (must be a number)\").format(weight=weight))\n\n    if unit == WeightUnitChoices.UNIT_KILOGRAM:\n        return int(weight * 1000)\n    if unit == WeightUnitChoices.UNIT_GRAM:\n        return int(weight)\n    if unit == WeightUnitChoices.UNIT_POUND:\n        return int(weight * Decimal(453.592))\n    if unit == WeightUnitChoices.UNIT_OUNCE:\n        return int(weight * Decimal(28.3495))\n    raise ValueError(\n        _(\"Unknown unit {unit}. Must be one of the following: {valid_units}\").format(\n            unit=unit,\n            valid_units=', '.join(WeightUnitChoices.values())\n        )\n    )", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Convert the given weight to integer grams.", "behavior_patterns": [], "semantic_contract": {"purpose": "Convert the given weight to integer grams.", "language": "python", "symbol_name": "to_grams", "symbol_type": "function", "signature": "(weight, unit)", "bases": [], "class_attrs": {}, "raises": ["ValueError", "TypeError"], "uses": ["Decimal (decimal)"], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
