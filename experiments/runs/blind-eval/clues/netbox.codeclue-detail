0',\n            'created_before': '2021-01-02T00:00:00',\n        }\n        self.assertEqual(self.filterset(params, self.queryset).qs.count(), 2)", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "class JournalEntryTestCase", "behavior_patterns": [], "semantic_contract": {"purpose": "class JournalEntryTestCase", "language": "python", "symbol_name": "JournalEntryTestCase", "symbol_type": "class", "signature": "", "bases": ["TestCase", "ChangeLoggedFilterSetTests"], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
