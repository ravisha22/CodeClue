er(\n            Q(object_types__id__in=values) | Q(object_types__isnull=True)\n        )", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "class TagFilterSet", "behavior_patterns": [], "semantic_contract": {"purpose": "class TagFilterSet", "language": "python", "symbol_name": "TagFilterSet", "symbol_type": "class", "signature": "", "bases": ["OwnerFilterMixin", "ChangeLoggedModelFilterSet"], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
