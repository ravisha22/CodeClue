tion is in maintenance mode", "behavior_patterns": [], "semantic_contract": {"purpose": "Middleware that checks if the application is in maintenance mode", "language": "python", "symbol_name": "MaintenanceModeMiddleware", "symbol_type": "class", "signature": "", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:netbox/netbox/middleware.py:MaintenanceModeMiddleware._set_session_type:238", "is_external": false}], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
