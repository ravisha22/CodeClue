{"node_id": "symbol:netbox/dcim/cable_profiles.py:BaseCableProfile.get_peer_termination:58", "symbol": "get_peer_termination", "type": "function", "file": "netbox/dcim/cable_profiles.py", "lines": [58, 82], "source": "    def get_peer_termination(self, termination, position):\n        \"\"\"\n        Given a terminating object, return the peer terminating object (if any) on the opposite end of the cable.\n        \"\"\"\n        try:\n            connector, position = self.get_mapped_position(\n                termination.cable_end,\n                termination.cable_connector,\n                position\n            )\n        except TypeError:\n            raise ValueError(\n                f\"Could not map connector {termination.cable_connector} position {position} on side \"\n                f\"{termination.cable_end}\"\n            )\n        try:\n            ct = CableTermination.objects.get(\n                cable=termination.cable,\n                cable_end=termination.opposite_cable_end,\n                connector=connector,\n                positions__contains=[position],\n            )\n            return ct.termination, position\n        except CableTermination.DoesNotExist:\n            return None, None", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Given a terminating object, return the peer terminating object (if any) on the opposite end of the cable.", "behavior_patterns": [], "semantic_contract": {"purpose": "Given a terminating object, return the peer terminating object (if any) on the opposite end of the cable.", "language": "python", "symbol_name": "get_peer_termination", "symbol_type": "function", "signature": "(termination, position)", "bases": [], "class_attrs": {}, "raises": ["ValueError"], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
