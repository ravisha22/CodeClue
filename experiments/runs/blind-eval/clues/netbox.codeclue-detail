tion_url(self.queryset.model, action='list', rest_api=True)\n\n        # Include quick add?\n        if self.quick_add:\n            widget.quick_add_context = {\n                'url': get_action_url(self.model, action='add'),\n                'params': {},\n            }\n            for k, v in self.quick_add_params.items():\n                if v == '$pk':\n                    # Replace \"$pk\" token with the primary key of the form's instance (if any)\n                    if getattr(form.instance, 'pk', None):\n                        widget.quick_add_context['params'][k] = form.instance.pk\n                else:\n                    widget.quick_add_context['params'][k] = v\n\n        return bound_field", "calls": ["__init__"], "called_by": [], "confidence": 0.92, "purpose": "Override `get_bound_field()` to avoid pre-populating field choices with a SQL query.", "behavior_patterns": [], "semantic_contract": {"purpose": "Override `get_bound_field()` to avoid pre-populating field choices with a SQL query.", "language": "python", "symbol_name": "DynamicModelChoiceMixin", "symbol_type": "class", "signature": "", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:netbox/utilities/forms/fields/dynamic.py:DynamicModelChoiceMixin.__init__:86", "is_external": false}], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
