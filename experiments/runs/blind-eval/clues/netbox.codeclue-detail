{"node_id": "symbol:netbox/extras/signals.py:notify_object_changed:138", "symbol": "notify_object_changed", "type": "function", "file": "netbox/extras/signals.py", "lines": [138, 179], "source": "def notify_object_changed(sender, instance, **kwargs):\n    # Skip for newly-created objects\n    if kwargs.get('created'):\n        return\n\n    # Determine event type\n    if 'created' in kwargs:\n        event_type = OBJECT_UPDATED\n    else:\n        event_type = OBJECT_DELETED\n\n    # Skip unsupported object types\n    if not has_feature(instance, 'notifications'):\n        return\n\n    ct = ContentType.objects.get_for_model(instance)\n\n    # Find all subscribed Users\n    subscribed_users = Subscription.objects.filter(\n        object_type=ct,\n        object_id=instance.pk\n    ).values_list('user', flat=True)\n    if not subscribed_users:\n        return\n\n    # Delete any existing Notifications for the object\n    Notification.objects.filter(\n        object_type=ct,\n        object_id=instance.pk,\n        user__in=subscribed_users\n    ).delete()\n\n    # Create Notifications for Subscribers\n    Notification.objects.bulk_create([\n        Notification(\n            user_id=user,\n            object=instance,\n            object_repr=Notification.get_object_repr(instance),\n            event_type=event_type\n        )\n        for user in subscribed_users\n    ])", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "function notify_object_changed", "behavior_patterns": ["GUARD(kwargs.get('created') -> return)", "BRANCH('created' in kwargs -> OBJECT_UPDATED, else -> OBJECT_DELETED)"], "semantic_contract": {"purpose": "function notify_object_changed", "language": "python", "symbol_name": "notify_object_changed", "symbol_type": "function", "signature": "(sender, instance)", "bases": [], "class_attrs": {}, "raises": [], "uses": ["Notification (extras.models)"], "behavior_patterns": ["GUARD(kwargs.get('created') -> return)", "BRANCH('created' in kwargs 