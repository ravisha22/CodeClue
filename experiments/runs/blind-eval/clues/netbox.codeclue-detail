{"node_id": "symbol:netbox/extras/tests/test_models.py:ConfigContextTest.test_config_context_annotation_query_optimization:739", "symbol": "test_config_context_annotation_query_optimization", "type": "function", "file": "netbox/extras/tests/test_models.py", "lines": [739, 781], "source": "    def test_config_context_annotation_query_optimization(self):\n        \"\"\"\n        Regression test for issue #20327: Ensure config context annotation\n        doesn't use expensive DISTINCT on main query.\n\n        Verifies that DISTINCT is only used in tag subquery where needed,\n        not on the main device query which is expensive for large datasets.\n        \"\"\"\n        device = Device.objects.first()\n        queryset = Device.objects.filter(pk=device.pk).annotate_config_context_data()\n\n        # Main device query should NOT use DISTINCT\n        self.assertFalse(queryset.query.distinct)\n\n        # Check that tag subqueries DO use DISTINCT by inspecting the annotation\n        config_annotation = queryset.query.annotations.get('config_context_data')\n        self.assertIsNotNone(config_annotation)\n\n        def find_tag_subqueries(where_node):\n            \"\"\"Find subqueries in WHERE clause that relate to tag filtering\"\"\"\n            subqueries = []\n\n            def traverse(node):\n                if hasattr(node, 'children'):\n                    for child in node.children:\n                        try:\n                            if child.rhs.query.model is TaggedItem:\n                                subqueries.append(child.rhs.query)\n                        except AttributeError:\n                            traverse(child)\n            traverse(where_node)\n            return subqueries\n\n        # Find subqueries in the WHERE clause that should have DISTINCT\n        tag_subqueries = find_tag_subqueries(config_annotation.query.where)\n        distinct_subqueries = [sq for sq in tag_subqueries if sq.distinct]\n\n        # Verify we found at least one DISTINCT subquery for tags\n        self.assertEqual(len(distinct_subqueries), 1)\n        self.assertTrue(distinct_subqueries[0].distinct)\n\n\nclass ConfigTemplateTest(TestCase):", "calls": ["traverse", "traverse", "find_tag_subqueries"], "called_by": [], "confidence": 0.92, "purpose": "Regression test for issue #20327: Ensure config context annotation", "behavior_patterns": [], "semantic_contract": {"purpose": "Regression test for issue #20327: Ensure config context annotation", "language": "python", "symbol_name": "test_config_context_annotation_query_optimization", "symbol_type": "function", "signature": "()", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:netbox/extras/tests/test_models.py:ConfigContextTest.test_config_context_annotation_query_optimization.find_tag_subqueries.traverse:761", "is_external": false}, {"target": "symbol:netbox/extras/tests/test_models.py:ConfigContextTest.test_config_context_annotation_query_optimization.find_tag_subqueries:757", "is_external": false}], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
