l(self.filterset(params, self.queryset).qs.count(), 1)\n\n    def test_action_type(self):\n        params = {'action_type': [EventRuleActionChoices.WEBHOOK]}\n        self.assertEqual(self.filterset(params, self.queryset).qs.count(), 3)\n        params = {'action_type': [EventRuleActionChoices.SCRIPT]}\n        self.assertEqual(self.filterset(params, self.queryset).qs.count(), 2)\n\n    def test_enabled(self):\n        params = {'enabled': True}\n        self.assertEqual(self.filterset(params, self.queryset).qs.count(), 2)\n        params = {'enabled': False}\n        self.assertEqual(self.filterset(params, self.queryset).qs.count(), 3)\n\n    def test_event_type(self):\n        params = {'event_type': [OBJECT_CREATED, OBJECT_UPDATED]}\n        self.assertEqual(self.filterset(params, self.queryset).qs.count(), 2)", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "class EventRuleTestCase", "behavior_patterns": [], "semantic_contract": {"purpose": "class EventRuleTestCase", "language": "python", "symbol_name": "EventRuleTestCase", "symbol_type": "class", "signature": "", "bases": ["TestCase", "BaseFilterSetTests"], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
