{"node_id": "symbol:netbox/utilities/data.py:drange:127", "symbol": "drange", "type": "function", "file": "netbox/utilities/data.py", "lines": [127, 139], "source": "def drange(start, end, step=decimal.Decimal(1)):\n    \"\"\"\n    Decimal-compatible implementation of Python's range()\n    \"\"\"\n    start, end, step = decimal.Decimal(start), decimal.Decimal(end), decimal.Decimal(step)\n    if start < end:\n        while start < end:\n            yield start\n            start += step\n    else:\n        while start > end:\n            yield start\n            start += step", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Decimal-compatible implementation of Python's range()", "behavior_patterns": ["BRANCH(start < end -> result, else -> result)"], "semantic_contract": {"purpose": "Decimal-compatible implementation of Python's range()", "language": "python", "symbol_name": "drange", "symbol_type": "function", "signature": "(start, end, step)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["BRANCH(start < end -> result, else -> result)"], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/utilities/data.py:flatten_dict:52", "symbol": "flatten_dict", "type": "function", "file": "netbox/utilities/data.py", "lines": [52, 67], "source": "def flatten_dict(d, prefix='', separator='.'):\n    \"\"\"\n    Flatten nested dictionaries into a single level by joining key names with a separator.\n\n    :param d: The dictionary to be flattened\n    :param prefix: Initial prefix (if any)\n    :param separator: The character to use when concatenating key names\n    \"\"\"\n    ret = {}\n    for k, v in d.items():\n        key = separator.join([prefix, k]) if prefix else k\n        if type(v) is dict:\n            ret.update(flatten_dict(v, prefix=key, separator=separator))\n        else:\n            ret[key] = v\n    return ret", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Flatten nested dictionaries into a single level by joining key names with a separator.", "behavior_patterns": ["ACCUMULATE(d.items() loop -> ret flatten dict)"], "semantic_contract": {"purpose": "Flatten nested dictionaries into a single level by joining key names with a separator.", "language": "python", "symbol_name": "flatten_dict", "symbol_type": "function", "signature": "(d, prefix, separator)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["ACCUMULATE(d.items() loop -> ret flatten dict)"], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/utilities/data.py:get_config_value_ci:26", "symbol": "get_config_value_ci", "type": "function", "file": "netbox/utilities/data.py", "lines": [26, 36], "source": "def get_config_value_ci(config_dict, key, default=None):\n    \"\"\"\n    Retrieve a value from a dictionary using case-insensitive key matching.\n    \"\"\"\n    if key in config_dict:\n        return config_dict[key]\n    key_lower = key.lower()\n    for config_key, value in config_dict.items():\n        if config_key.lower() == key_lower:\n            return value\n    return default", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Retrieve a value from a dictionary using case-insensitive key matching.", "behavior_patterns": ["ACCUMULATE(config_dict.items() loop -> result)"], "semantic_contract": {"purpose": "Retrieve a value from a dictionary using case-insensitive key matching.", "language": "python", "symbol_name": "get_config_value_ci", "symbol_type": "function", "signature": "(config_dict, key, default)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["ACCUMULATE(config_dict.items() loop -> result)"], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/utilities/data.py:ranges_to_string:181", "symbol": "ranges_to_string", "type": "function", "file": "netbox/utilities/data.py", "lines": [181, 197], "source": "def ranges_to_string(ranges):\n    \"\"\"\n    Converts a list of ranges into a string representation.\n\n    This function takes a list of range objects and produces a string\n    representation of those ranges. Each range is represented as a\n    hyphen-separated pair of lower and upper bounds, with inclusive or\n    exclusive bounds adjusted accordingly. If the lower and upper bounds\n    of a range are the same, only the single value is added to the string.\n    Intended for use with ArrayField.\n\n    Example:\n        [NumericRange(1, 5), NumericRange(8, 9), NumericRange(10, 12)] => \"1-5,8,10-12\"\n    \"\"\"\n    if not ranges:\n        return ''\n    return ','.join(ranges_to_string_list(ranges))", "calls": ["ranges_to_string_list"], "called_by": [], "confidence": 0.92, "purpose": "Converts a list of ranges into a string representation.", "behavior_patterns": [], "semantic_contract": {"purpose": "Converts a list of ranges into a string representation.", "language": "python", "symbol_name": "ranges_to_string", "symbol_type": "function", "signature": "(ranges)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:netbox/utilities/data.py:ranges_to_string_list:158", "is_external": false}], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/utilities/data.py:ranges_to_string_list:158", "symbol": "ranges_to_string_list", "type": "function", "file": "netbox/utilities/data.py", "lines": [158, 178], "source": "def ranges_to_string_list(ranges):\n    \"\"\"\n    Convert numeric ranges to a list of display strings.\n\n    Each range is rendered as \"lower-upper\" or \"lower\" (for singletons).\n    Bounds are normalized to inclusive values using ``lower_inc``/``upper_inc``.\n    This underpins ``ranges_to_string()``, which joins the result with commas.\n\n    Example:\n        [NumericRange(1, 6), NumericRange(8, 9), NumericRange(10, 13)] => [\"1-5\", \"8\", \"10-12\"]\n    \"\"\"\n    if not ranges:\n        return []\n\n    output: list[str] = []\n    for r in ranges:\n        # Compute inclusive bounds regardless of how the DB range is stored.\n        lower = r.lower if r.lower_inc else r.lower + 1\n        upper = r.upper if r.upper_inc else r.upper - 1\n        output.append(f\"{lower}-{upper}\" if lower != upper else str(lower))\n    return output", "calls": [], "called_by": ["ranges_to_string"], "confidence": 0.92, "purpose": "Convert numeric ranges to a list of display strings.", "behavior_patterns": ["ACCUMULATE(ranges loop -> output ifexp)"], "semantic_contract": {"purpose": "Convert numeric ranges to a list of display strings.", "language": "python", "symbol_name": "ranges_to_string_list", "symbol_type": "function", "signature": "(ranges)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["ACCUMULATE(ranges loop -> output ifexp)"], "tier": 1, "calls": [], "called_by": [{"source": "symbol:netbox/utilities/data.py:ranges_to_string:181"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/utilities/data.py:resolve_attr_path:237", "symbol": "resolve_attr_path", "type": "function", "file": "netbox/utilities/data.py", "lines": [237, 253], "source": "def resolve_attr_path(obj, path):\n    \"\"\"\n    Follow a dotted path across attributes and/or dictionary keys and return the final value.\n\n    Parameters:\n        obj: The starting object\n        path: The dotted path to follow (e.g. \"foo.bar.baz\")\n    \"\"\"\n    cur = obj\n    for part in path.split('.'):\n        if cur is None:\n            return None\n        try:\n            cur = getattr(cur, part) if hasattr(cur, part) else cur.get(part)\n        except AttributeError:\n            cur = None\n    return cur", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Follow a dotted path across attributes and/or dictionary keys and return the final value.", "behavior_patterns": ["ACCUMULATE(path.split('.') loop -> result)"], "semantic_contract": {"purpose": "Follow a dotted path across attributes and/or dictionary keys and return the final value.", "language": "python", "symbol_name": "resolve_attr_path", "symbol_type": "function", "signature": "(obj, path)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["ACCUMULATE(path.split('.') loop -> result)"], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
