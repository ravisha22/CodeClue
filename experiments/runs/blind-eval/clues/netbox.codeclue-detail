inks in group_names.items():\n\n        links_rendered = []\n\n        for cl in links:\n            try:\n                if rendered := cl.render(link_context):\n                    links_rendered.append(\n                        GROUP_LINK.format(rendered['link'], rendered['link_target'], rendered['text'])\n                    )\n            except Exception as e:\n                links_rendered.append(\n                    f'<li><a class=\"dropdown-item\" disabled=\"disabled\" title=\"{e}\"><span class=\"text-muted\">'\n                    f'<i class=\"mdi mdi-alert\"></i> {cl.name}</span></a></li>'\n                )\n\n        if links_rendered:\n            template_code += GROUP_BUTTON.format(\n                links[0].button_class, escape(group), ''.join(links_rendered)\n            )\n\n    return mark_safe(template_code)", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Render all applicable links for the given object.", "behavior_patterns": ["ACCUMULATE(custom_links loop -> group names cl)"], "semantic_contract": {"purpose": "Render all applicable links for the given object.", "language": "python", "symbol_name": "custom_links", "symbol_type": "function", "signature": "(context, obj)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["ACCUMULATE(custom_links loop -> group names cl)"], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
