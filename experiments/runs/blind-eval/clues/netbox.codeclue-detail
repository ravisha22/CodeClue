;3\\n\"\n            \"4;5;6\\n\"\n        )\n        self.assertEqual(form._clean_csv(data, delimiter=';'), [\n            {'a': '1', 'b': '2', 'c': '3'},\n            {'a': '4', 'b': '5', 'c': '6'},\n        ])\n\n        data = (\n            \"a\\tb\\tc\\n\"\n            \"1\\t2\\t3\\n\"\n            \"4\\t5\\t6\\n\"\n        )\n        self.assertEqual(form._clean_csv(data, delimiter='\\t'), [\n            {'a': '1', 'b': '2', 'c': '3'},\n            {'a': '4', 'b': '5', 'c': '6'},\n        ])", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "class ImportFormTest", "behavior_patterns": [], "semantic_contract": {"purpose": "class ImportFormTest", "language": "python", "symbol_name": "ImportFormTest", "symbol_type": "class", "signature": "", "bases": ["TestCase"], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
