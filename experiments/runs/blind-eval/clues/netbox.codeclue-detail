odel)", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Register counter fields and connect signal handlers for their child models.", "behavior_patterns": ["ACCUMULATE(models loop -> connected to model)"], "semantic_contract": {"purpose": "Register counter fields and connect signal handlers for their child models.", "language": "python", "symbol_name": "connect_counters", "symbol_type": "function", "signature": "()", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["ACCUMULATE(models loop -> connected to model)"], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
