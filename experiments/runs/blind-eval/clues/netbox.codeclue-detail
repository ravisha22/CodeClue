{"node_id": "symbol:netbox/utilities/permissions.py:resolve_permission:30", "symbol": "resolve_permission", "type": "function", "file": "netbox/utilities/permissions.py", "lines": [30, 45], "source": "def resolve_permission(name):\n    \"\"\"\n    Given a permission name, return the app_label, action, and model_name components. For example, \"dcim.view_site\"\n    returns (\"dcim\", \"view\", \"site\").\n\n    :param name: Permission name in the format <app_label>.<action>_<model>\n    \"\"\"\n    try:\n        app_label, codename = name.split('.')\n        action, model_name = codename.rsplit('_', 1)\n    except ValueError:\n        raise ValueError(\n            _(\"Invalid permission name: {name}. Must be in the format <app_label>.<action>_<model>\").format(name=name)\n        )\n\n    return app_label, action, model_name", "calls": [], "called_by": ["permission_is_exempt", "resolve_permission_type"], "confidence": 0.92, "purpose": "Given a permission name, return the app_label, action, and model_name components.", "behavior_patterns": [], "semantic_contract": {"purpose": "Given a permission name, return the app_label, action, and model_name components.", "language": "python", "symbol_name": "resolve_permission", "symbol_type": "function", "signature": "(name)", "bases": [], "class_attrs": {}, "raises": ["ValueError"], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [{"source": "symbol:netbox/utilities/permissions.py:permission_is_exempt:65"}, {"source": "symbol:netbox/utilities/permissions.py:resolve_permission_type:48"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
