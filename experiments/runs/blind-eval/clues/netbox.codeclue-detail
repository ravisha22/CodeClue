{"node_id": "symbol:netbox/extras/lookups.py:JSONEmpty:51", "symbol": "JSONEmpty", "type": "class", "file": "netbox/extras/lookups.py", "lines": [51, 72], "source": "class JSONEmpty(Lookup):\n    \"\"\"\n    Support \"empty\" lookups for JSONField keys.\n\n    A key is considered empty if it is \"\", null, or does not exist.\n    \"\"\"\n    lookup_name = 'empty'\n\n    def as_sql(self, compiler, connection):\n        # self.lhs.lhs is the parent expression (could be a JSONField or another KeyTransform)\n        # Rebuild the expression using KeyTextTransform to guarantee ->> (text)\n        text_expr = KeyTextTransform(self.lhs.key_name, self.lhs.lhs)\n        lhs_sql, lhs_params = compiler.compile(text_expr)\n\n        value = self.rhs\n        if value not in (True, False):\n            raise ValueError(\"The 'empty' lookup only accepts True or False.\")\n\n        condition = '' if value else 'NOT '\n        sql = f\"(NULLIF({lhs_sql}, '') IS {condition}NULL)\"\n\n        return sql, lhs_params", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Support \"empty\" lookups for JSONField keys.", "behavior_patterns": [], "semantic_contract": {"purpose": "Support \"empty\" lookups for JSONField keys.", "language": "python", "symbol_name": "JSONEmpty", "symbol_type": "class", "signature": "", "bases": ["Lookup"], "class_attrs": {"lookup_name": "'empty'"}, "raises": ["ValueError"], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
