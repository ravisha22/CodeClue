ator(multiple=self.multipleOf)\n                ]\n\n        return self.field_class(**field_kwargs)", "calls": ["field_class"], "called_by": [], "confidence": 0.92, "purpose": "Instantiate and return a Django form field suitable for editing the property's value.", "behavior_patterns": ["PRECEDENCE(items_type -> field_kwargs)"], "semantic_contract": {"purpose": "Instantiate and return a Django form field suitable for editing the property's value.", "language": "python", "symbol_name": "to_form_field", "symbol_type": "function", "signature": "(name, required)", "bases": [], "class_attrs": {}, "raises": [], "uses": ["RegexValidator (django.core.validators)", "MultipleOfValidator (utilities.validators)"], "behavior_patterns": ["PRECEDENCE(items_type -> field_kwargs)"], "tier": 1, "calls": [{"target": "symbol:netbox/utilities/jsonschema.py:JSONSchemaProperty.field_class:134", "is_external": false}], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/utilities/jsonschema.py:JSONSchemaProperty:64", "symbol": "JSONSchemaProperty", "type": "class", "file": "netbox/utilities/jsonschema.py", "lines": [64, 150], "source": "class JSONSchemaProperty:\n    type: PropertyTypeEnum = PropertyTypeEnum.STRING.value\n    title: str | None = None\n    description: str | None = None\n    default: Any = None\n    enum: list | None = None\n\n    # Strings\n    minLength: int | None = None\n    maxLength: int | None = None\n    pattern: str | None = None  # Regex\n    format: StringFormatEnum | None = None\n\n    # Numbers\n    minimum: int | float | None = None\n    maximum: int | float | None = None\n    multipleOf: int | float | None = None\n\n    # Arrays\n    items: dict | None = field(default_factory=dict)\n\n    def to_form_field(self, name, required=False):\n        \"\"\"\n        Instantiate and return a Django form field suitable for editing the property's value.\n        \"\"\"\n        field_kwargs = {\n            'label': self.title or title(name),\n            'help_text': self.description,\n            'required': required,\n            'initial': self.default,\n        }\n\n        # Choices\n        if self.enum:\n            choices = [(v, v) for v in self.enum]\n            if not required:\n                choices = [(None, ''), *choices]\n            field_kwargs['choices'] = choices\n\n        # Arrays\n        if self.type == PropertyTypeEnum.ARRAY.value:\n            items_type = self.items.get('type', PropertyTypeEnum.STRING.value)\n            field_kwargs['base_field'] = FORM_FIELDS[items_type]()\n\n        # String validation\n        if self.type == PropertyTypeEnum.STRING.value:\n            if self.minLength is not None:\n                field_kwargs['min_length'] = self.minLength\n            if self.maxLength is not None:\n                field_kwargs['max_length'] = self.maxLength\n            if self.pattern is not None:\n                field_kwargs['validators'] = [\