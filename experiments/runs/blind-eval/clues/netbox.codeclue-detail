{"node_id": "symbol:netbox/utilities/proxy.py:DefaultProxyRouter.route:23", "symbol": "route", "type": "function", "file": "netbox/utilities/proxy.py", "lines": [23, 39], "source": "    def route(self, url=None, protocol=None, context=None):\n        \"\"\"\n        Returns the appropriate proxy given a URL or protocol. Arbitrary context data may also be passed where\n        available.\n\n        Args:\n            url: The specific request URL for which the proxy will be used (if known)\n            protocol: The protocol in use (e.g. http or https) (if known)\n            context: Additional context to aid in proxy selection. May include e.g. the requesting client.\n        \"\"\"\n        if url and protocol is None:\n            protocol = self._get_protocol_from_url(url)\n        if protocol and protocol in settings.HTTP_PROXIES:\n            return {\n                protocol: settings.HTTP_PROXIES[protocol]\n            }\n        return settings.HTTP_PROXIES", "calls": ["_get_protocol_from_url"], "called_by": ["resolve_proxies"], "confidence": 0.92, "purpose": "Returns the appropriate proxy given a URL or protocol.", "behavior_patterns": [], "semantic_contract": {"purpose": "Returns the appropriate proxy given a URL or protocol.", "language": "python", "symbol_name": "route", "symbol_type": "function", "signature": "(url, protocol, context)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:netbox/utilities/proxy.py:DefaultProxyRouter._get_protocol_from_url:17", "is_external": false}], "called_by": [{"source": "symbol:netbox/utilities/proxy.py:resolve_proxies:42"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/utilities/proxy.py:DefaultProxyRouter:12", "symbol": "DefaultProxyRouter", "type": "class", "file": "netbox/utilities/proxy.py", "lines": [12, 39], "source": "class DefaultProxyRouter:\n    \"\"\"\n    Base class for a proxy router.\n    \"\"\"\n    @staticmethod\n    def _get_protocol_from_url(url):\n        \"\"\"\n        Determine the applicable protocol (e.g. HTTP or HTTPS) from the given URL.\n        \"\"\"\n        return urlparse(url).scheme\n\n    def route(self, url=None, protocol=None, context=None):\n        \"\"\"\n        Returns the appropriate proxy given a URL or protocol. Arbitrary context data may also be passed where\n        available.\n\n        Args:\n            url: The specific request URL for which the proxy will be used (if known)\n            protocol: The protocol in use (e.g. http or https) (if known)\n            context: Additional context to aid in proxy selection. May include e.g. the requesting client.\n        \"\"\"\n        if url and protocol is None:\n            protocol = self._get_protocol_from_url(url)\n        if protocol and protocol in settings.HTTP_PROXIES:\n            return {\n                protocol: settings.HTTP_PROXIES[protocol]\n            }\n        return settings.HTTP_PROXIES", "calls": ["_get_protocol_from_url"], "called_by": [], "confidence": 0.92, "purpose": "Base class for a proxy router.", "behavior_patterns": [], "semantic_contract": {"purpose": "Base class for a proxy router.", "language": "python", "symbol_name": "DefaultProxyRouter", "symbol_type": "class", "signature": "", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:netbox/utilities/proxy.py:DefaultProxyRouter._get_protocol_from_url:17", "is_external": false}], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
