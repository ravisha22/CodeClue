{"node_id": "symbol:netbox/dcim/tests/test_models.py:CableTestCase.test_path_refreshes_replaced_cablepath_reference:1350", "symbol": "test_path_refreshes_replaced_cablepath_reference", "type": "function", "file": "netbox/dcim/tests/test_models.py", "lines": [1350, 1375], "source": "    def test_path_refreshes_replaced_cablepath_reference(self):\n        \"\"\"\n        An already-instantiated interface should refresh its denormalized\n        `_path` foreign key when the referenced CablePath row has been\n        replaced in the database.\n        \"\"\"\n        stale_interface = Interface.objects.get(device__name='TestDevice1', name='eth0')\n        old_path = CablePath.objects.get(pk=stale_interface._path_id)\n\n        new_path = CablePath(\n            path=old_path.path,\n            is_active=old_path.is_active,\n            is_complete=old_path.is_complete,\n            is_split=old_path.is_split,\n        )\n        old_path_id = old_path.pk\n        old_path.delete()\n        new_path.save()\n\n        # The old CablePath no longer exists\n        self.assertFalse(CablePath.objects.filter(pk=old_path_id).exists())\n\n        # The already-instantiated interface still points to the deleted path\n        # until the accessor refreshes `_path` from the database.\n        self.assertEqual(stale_interface._path_id, old_path_id)\n        self.assertEqual(stale_interface.path.pk, new_path.pk)", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "An already-instantiated interface should refresh its denormalized", "behavior_patterns": [], "semantic_contract": {"purpose": "An already-instantiated interface should refresh its denormalized", "language": "python", "symbol_name": "test_path_refreshes_replaced_cablepath_reference", "symbol_type": "function", "signature": "()", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_p