, 'image-attachments', kwargs={'model': model})(\n                'netbox.views.generic.ObjectImageAttachmentsView'\n            )\n        if issubclass(model, SyncedDataMixin):\n            register_model_view(model, 'sync', kwargs={'model': model})(\n                'netbox.views.generic.ObjectSyncDataView'\n            )", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Register one or more models in NetBox.", "behavior_patterns": ["ACCUMULATE(models loop -> registry model name)"], "semantic_contract": {"purpose": "Register one or more models in NetBox.", "language": "python", "symbol_name": "register_models", "symbol_type": "function", "signature": "()", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["ACCUMULATE(models loop -> registry model name)"], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
