eldTypeChoices.TYPE_DATETIME:\n            filter_class = filters.MultiValueDateTimeFilter\n\n        # Select\n        elif self.type == CustomFieldTypeChoices.TYPE_SELECT:\n            filter_class = filters.MultiValueCharFilter\n\n        # Multiselect\n        elif self.type == CustomFieldTypeChoices.TYPE_MULTISELECT:\n            filter_class = filters.MultiValueArrayFilter\n\n        # Object\n        elif self.type == CustomFieldTypeChoices.TYPE_OBJECT:\n            filter_class = filters.MultiValueNumberFilter\n\n        # Multi-object\n        elif self.type == CustomFieldTypeChoices.TYPE_MULTIOBJECT:\n            filter_class = filters.MultiValueNumberFilter\n            kwargs['lookup_expr'] = 'contains'\n\n        # Unsupported custom field type\n        else:\n            return None\n\n        filter_instance = filter_class(**kwargs)\n        filter_instance.custom_field = self\n\n        return filter_instance", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Return a django_filters Filter instance suitable for this field type.", "behavior_patterns": ["PRECEDENCE(empty -> kwargs -> filter_class)"], "semantic_contract": {"purpose": "Return a django_filters Filter instance suitable for this field type.", "language": "python", "symbol_name": "to_filter", "symbol_type": "function", "signature": "(lookup_expr)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["PRECEDENCE(empty -> kwargs -> filter_class)"], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
