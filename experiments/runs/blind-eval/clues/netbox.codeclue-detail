orm': form,\n            'table': table,\n        })", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "function get", "behavior_patterns": [], "semantic_contract": {"purpose": "function get", "language": "python", "symbol_name": "get", "symbol_type": "function", "signature": "(request)", "bases": [], "class_attrs": {}, "raises": [], "uses": ["SearchTable (netbox.tables)", "SearchForm (netbox.forms)", "RequestConfig (django_tables2)"], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
