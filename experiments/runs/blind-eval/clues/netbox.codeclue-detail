{"node_id": "symbol:netbox/utilities/querysets.py:RestrictedQuerySet.restrict:40", "symbol": "restrict", "type": "function", "file": "netbox/utilities/querysets.py", "lines": [40, 70], "source": "    def restrict(self, user, action='view'):\n        \"\"\"\n        Filter the QuerySet to return only objects on which the specified user has been granted the specified\n        permission.\n\n        :param user: User instance\n        :param action: The action which must be permitted (e.g. \"view\" for \"dcim.view_site\"); default is 'view'\n        \"\"\"\n        # Resolve the full name of the required permission\n        permission_required = get_permission_for_model(self.model, action)\n\n        # Bypass restriction for superusers and exempt views\n        if user and user.is_superuser or permission_is_exempt(permission_required):\n            return self\n\n        # User is anonymous or has not been granted the requisite permission\n        if user is None or not user.is_authenticated or permission_required not in user.get_all_permissions():\n            return self.none()\n\n        # Filter the queryset to include only objects with allowed attributes\n        constraints = user._object_perm_cache[permission_required]\n        tokens = {\n            CONSTRAINT_TOKEN_USER: user,\n        }\n        if attrs := qs_filter_from_constraints(constraints, tokens):\n            # #8715: Avoid duplicates when JOIN on many-to-many fields without using DISTINCT.\n            # DISTINCT acts globally on the entire request, which may not be desirable.\n            allowed_objects = self.model.objects.filter(attrs)\n            return self.filter(pk__in=allowed_objects)\n\n        return self", "calls": [], "called_by": ["get_current_querysets", "RestrictedPrefetch"], "confidence": 0.92, "purpose": "Filter the QuerySet to return only objects on which the specified user has been granted the specified", "behavior_patterns": [], "semantic_contract": {"purpose": "Filter the QuerySet to return only objects on which the specified user has been granted the specified", "language": "python", "symbol_name": "restrict", "symbol_type": "function", "signature": "(user, action)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [{"source": "symbol:netbox/utilities/querysets.py:RestrictedPrefetch.get_current_querysets:23"}, {"source": "symbol:netbox/utilities/querysets.py:RestrictedPrefetch:12"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/utilities/querysets.py:RestrictedQuerySet:38", "symbol": "RestrictedQuerySet", "type": "class", "file": "netbox/utilities/querysets.py", "lines": [38, 70], "source": "class RestrictedQuerySet(QuerySet):\n\n    def restrict(self, user, action='view'):\n        \"\"\"\n        Filter the QuerySet to return only objects on which the specified user has been granted the specified\n        permission.\n\n        :param user: User instance\n        :param action: The action which must be permitted (e.g. \"view\" for \"dcim.view_site\"); default is 'view'\n        \"\"\"\n        # Resolve the full name of the required permission\n        permission_required = get_permission_for_model(self.model, action)\n\n        # Bypass restriction for superusers and exempt views\n        if user and user.is_superuser or permission_is_exempt(permission_required):\n            return self\n\n        # User is anonymous or has not been granted the requisite permission\n        if user is None or not user.is_authenticated or permission_required not in user.get_all_permissions():\n            return self.none()\n\n        # Filter the queryset to include only objects with allowed attributes\n        constraints = user._object_perm_cache[permission_required]\n        tokens = {\n            CONSTRAINT_TOKEN_USER: user,\n        }\n        if attrs := qs_filter_from_constraints(constraints, tokens):\n            # #8715: Avoid duplicates when JOIN on many-to-many fields without using DISTINCT.\n            # DISTINCT acts globally on the entire request, which may not be desirable.\n            allowed_objects = self.model.objects.filter(attrs)\n            return self.filter(pk__in=allowed_objects)\n\n        return self", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "class RestrictedQuerySet", "behavior_patterns": [], "semantic_contract": {"purpose": "class RestrictedQuerySet", "language": "python", "symbol_name": "RestrictedQuerySet", "symbol_type"