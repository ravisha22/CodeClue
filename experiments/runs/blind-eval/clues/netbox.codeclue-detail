elf):\n        self.add_permissions('extras.add_scriptmodule', 'core.add_managedfile')\n        response = self.client.post(self.url, {}, format='json', **self.header)\n        self.assertHttpStatus(response, status.HTTP_400_BAD_REQUEST)", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Tests for the POST /api/extras/scripts/upload/ endpoint.", "behavior_patterns": [], "semantic_contract": {"purpose": "Tests for the POST /api/extras/scripts/upload/ endpoint.", "language": "python", "symbol_name": "ScriptModuleTest", "symbol_type": "class", "signature": "", "bases": ["APITestCase"], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
