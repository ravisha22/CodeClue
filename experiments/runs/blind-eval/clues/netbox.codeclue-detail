{"node_id": "symbol:netbox/utilities/forms/widgets/select.py:SelectMultipleBase.optgroups:93", "symbol": "optgroups", "type": "function", "file": "netbox/utilities/forms/widgets/select.py", "lines": [93, 112], "source": "    def optgroups(self, name, value, attrs=None):\n        filtered_choices = []\n        include_selected = self.include_selected\n\n        for choice in self.choices:\n            if isinstance(choice[1], (list, tuple)):  # optgroup\n                group_label, group_choices = choice\n                filtered_group = [\n                    c for c in group_choices if (str(c[0]) in value) == include_selected\n                ]\n\n                if filtered_group:  # Only include optgroup if it has choices left\n                    filtered_choices.append((group_label, filtered_group))\n            else:  # option, e.g. flat choice\n                if (str(choice[0]) in value) == include_selected:\n                    filtered_choices.append(choice)\n\n        self.choices = filtered_choices\n        value = []  # Clear selected choices\n        return super().optgroups(name, value, attrs)", "calls": [], "called_by": ["SelectMultipleBase"], "confidence": 0.92, "purpose": "function optgroups", "behavior_patterns": ["ACCUMULATE(self.choices loop -> filtered choices value)"], "semantic_contract": {"purpose": "function optgroups", "language": "python", "symbol_name": "optgroups", "symbol_type": "function", "signature": "(name, value, attrs)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["ACCUMULATE(self.choices loop -> filtered choices value)"], "tier": 1, "calls": [], "called_by": [{"source": "symbol:netbox/utilities/forms/widgets/select.py:SelectMultipleBase:86"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/utilities/forms/widgets/select.py:SelectMultipleBase:86", "symbol": "SelectMultipleBase", "type": "class", "file": "netbox/utilities/forms/widgets/select.py", "lines": [86, 117], "source": "class SelectMultipleBase(forms.SelectMultiple):\n    \"\"\"\n    Base class for select widgets that filter choices based on selected values.\n    Subclasses should set `include_selected` to control filtering behavior.\n    \"\"\"\n    include_selected = False\n\n    def optgroups(self, name, value, attrs=None):\n        filtered_choices = []\n        include_selected = self.include_selected\n\n        for choice in self.choices:\n            if isinstance(choice[1], (list, tuple)):  # optgroup\n                group_label, group_choices = choice\n                filtered_group = [\n                    c for c in group_choices if (str(c[0]) in value) == include_selected\n                ]\n\n                if filtered_group:  # Only include optgroup if it has choices left\n                    filtered_choices.append((group_label, filtered_group))\n            else:  # option, e.g. flat choice\n                if (str(choice[0]) in value) == include_selected:\n                    filtered_choices.append(choice)\n\n        self.choices = filtered_choices\n        value = []  # Clear selected choices\n        return super().optgroups(name, value, attrs)\n\n    def create_option(self, name, value, label, selected, index, subindex=None, attrs=None):\n        option = super().create_option(name, value, label, selected, index, subindex, attrs)\n        option['attrs']['title'] = label  # Add title attribute to show full text on hover\n        return option", "calls": ["create_option", "optgroups"], "called_by": [], "confidence": 0.92, "purpose": "Base class for select widgets that filter choices based on selected values.", "behavior_patterns": [], "semantic_contract": {"purpose": "Base class for select widgets that filter choices based on selected values.", "l