xt = self.panel_no_perm.get_context(self._make_context(self.user))\n        self.assertFalse(self.panel_no_perm.should_render(context))", "calls": ["_make_context", "_make_context"], "called_by": [], "confidence": 0.92, "purpose": "Verify that ObjectsTablePanel.should_render() hides the panel when", "behavior_patterns": [], "semantic_contract": {"purpose": "Verify that ObjectsTablePanel.should_render() hides the panel when", "language": "python", "symbol_name": "ObjectsTablePanelTest", "symbol_type": "class", "signature": "", "bases": ["TestCase"], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:netbox/netbox/tests/test_ui.py:ObjectsTablePanelTest._make_context:244", "is_external": false}], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
