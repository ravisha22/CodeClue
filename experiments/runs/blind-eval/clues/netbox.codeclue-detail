_contract": {"purpose": "function post", "language": "python", "symbol_name": "post", "symbol_type": "function", "signature": "(request, pk)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["BRANCH(member_select_form.is_valid() -> return redirect(reque..., else -> fo...)"], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/dcim/views.py:VirtualChassisAddMemberView:4407", "symbol": "VirtualChassisAddMemberView", "type": "class", "file": "netbox/dcim/views.py", "lines": [4407, 4460], "source": "class VirtualChassisAddMemberView(ObjectPermissionRequiredMixin, GetReturnURLMixin, View):\n    queryset = VirtualChassis.objects.all()\n\n    def get_required_permission(self):\n        return 'dcim.change_virtualchassis'\n\n    def get(self, request, pk):\n        virtual_chassis = get_object_or_404(self.queryset, pk=pk)\n        initial_data = {k: request.GET[k] for k in request.GET}\n        member_select_form = forms.VCMemberSelectForm(initial=initial_data)\n        membership_form = forms.DeviceVCMembershipForm(initial=initial_data)\n\n        return render(request, 'dcim/virtualchassis_add_member.html', {\n            'virtual_chassis': virtual_chassis,\n            'member_select_form': member_select_form,\n            'membership_form': membership_form,\n            'return_url': self.get_return_url(request, virtual_chassis),\n        })\n\n    def post(self, request, pk):\n        virtual_chassis = get_object_or_404(self.queryset, pk=pk)\n        member_select_form = forms.VCMemberSelectForm(request.POST)\n\n        if member_select_form.is_valid():\n            device = member_select_form.cleaned_data['device']\n            device.snapshot()\n            device.virtual_chassis = virtual_chassis\n            data = {\n                'vc_position': request.POST['vc_position'],\n                'vc_priority': request.POST['vc_priority'],\n            }\n            membership_form = forms.DeviceVCMembershipForm(data=data, validate_vc_position=True, instance=device)\n\n            if membership_form.is_valid():\n                membership_form.save()\n                messages.success(request, mark_safe(\n                    _('Added member <a href=\"{url}\">{device}</a>').format(\n                        url=device.get_absolute_url(), device=escape(device)\n                    )\n                ))\n\n                if '_addanother' in request.POST and safe_for_redirect(request.get_full_path()):\n                    return redirect(request.get_full_path())\n                return redirect(self.get_return_url(request, device))\n\n        else:\n            membership_form = forms.DeviceVCMembershipForm(data=request.POST)\n\n        return render(request, 'dcim/virtualchassis_add_member.html', {\n            'virtual_chassis': virtual_chassis,\n            'member_select_form': member_select_form,\n            'membership_form': membership_form,\n            'return_url': self.get_return_url(request, virtual_chassis),\n        })", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "class VirtualChassisAddMemberView", "behavior_patterns": [], "semantic_contract": {"purpose": "class VirtualChassisAddMemberView", "language": "python", "symbol_name": "VirtualChassisAddMemberView", "symbol_type": "class", "signature": "", "bases": ["ObjectPermissionRequiredMixin", "GetReturnURLMixin", "View"], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
