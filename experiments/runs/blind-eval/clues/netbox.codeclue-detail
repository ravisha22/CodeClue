     )\n        else:\n            for obj in queryset:\n                component = obj.instantiate(device=self)\n                # Set default values for any applicable custom fields\n                if cf_defaults := CustomField.objects.get_defaults_for_model(model):\n                    component.custom_field_data = cf_defaults\n                component.save()", "calls": [], "called_by": ["Device", "Device", "Device", "Device", "Device", "Device", "Device", "Device", "Device", "Device"], "confidence": 0.92, "purpose": "Instantiate components for the device from the specified component templates.", "behavior_patterns": ["BRANCH(bulk_create -> return, else -> result)"], "semantic_contract": {"purpose": "Instantiate components for the device from the specified component templates.", "language": "python", "symbol_name": "_instantiate_components", "symbol_type": "function", "signature": "(queryset, bulk_create)", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": ["BRANCH(bulk_create -> return, else -> result)"], "tier": 1, "calls": [], "called_by": [{"source": "symbol:netbox/dcim/models/devices.py:Device:497"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
