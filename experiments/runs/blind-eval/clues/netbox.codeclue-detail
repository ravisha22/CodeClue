template': self.base_template,\n            'config_template': config_template,\n            'context_data': context_data,\n            'rendered_config': rendered_config,\n            'error_message': error_message,\n        }", "calls": ["get_object", "get_extra_context_data"], "called_by": [], "confidence": 0.92, "purpose": "class ObjectRenderConfigView", "behavior_patterns": [], "semantic_contract": {"purpose": "class ObjectRenderConfigView", "language": "python", "symbol_name": "ObjectRenderConfigView", "symbol_type": "class", "signature": "", "bases": ["ObjectView"], "class_attrs": {"base_template": "None", "template_name": "'extras/object_render_config.html'"}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:netbox/extras/views.py:BaseScriptView.get_object:1642", "is_external": false}, {"target": "symbol:netbox/extras/views.py:ObjectRenderConfigView.get_extra_context_data:1261", "is_external": false}], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
