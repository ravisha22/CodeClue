ean()\n\n        # Overlapping range ending within existing\n        with self.assertRaises(ValidationError):\n            iprange_4_198_201 = IPRange.objects.create(\n                start_address=IPNetwork('1.2.4.198/24'), end_address=IPNetwork('1.2.4.201/24')\n            )\n            iprange_4_198_201.clean()", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "function test_overlapping_range", "behavior_patterns": [], "semantic_contract": {"purpose": "function test_overlapping_range", "language": "python", "symbol_name": "test_overlapping_range", "symbol_type": "function", "signature": "()", "bases": [], "class_attrs": {}, "raises": [], "uses": ["IPNetwork (netaddr)"], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
