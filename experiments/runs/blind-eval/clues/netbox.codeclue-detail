{"node_id": "symbol:netbox/netbox/graphql/views.py:NetBoxGraphQLView.dispatch:19", "symbol": "dispatch", "type": "function", "file": "netbox/netbox/graphql/views.py", "lines": [19, 42], "source": "    def dispatch(self, request, *args, **kwargs):\n        config = get_config()\n\n        # Enforce GRAPHQL_ENABLED\n        if not config.GRAPHQL_ENABLED:\n            return HttpResponseNotFound(\"The GraphQL API is not enabled.\")\n\n        # Attempt to authenticate the user using a DRF token, if provided\n        if not request.user.is_authenticated:\n            authenticator = TokenAuthentication()\n            try:\n                auth_info = authenticator.authenticate(request)\n                if auth_info is not None:\n                    request.user = auth_info[0]  # User object\n            except AuthenticationFailed as exc:\n                return HttpResponseForbidden(exc.detail)\n\n        # Enforce LOGIN_REQUIRED\n        if settings.LOGIN_REQUIRED and not request.user.is_authenticated:\n            if request.accepts(\"text/html\"):\n                return redirect_to_login(reverse('graphql'))\n            return HttpResponseForbidden(\"No credentials provided.\")\n\n        return super().dispatch(request, *args, **kwargs)", "calls": [], "called_by": ["NetBoxGraphQLView"], "confidence": 0.92, "purpose": "function dispatch", "behavior_patterns": [], "semantic_contract": {"purpose": "function dispatch", "language": "python", "symbol_name": "dispatch", "symbol_type": "function", "signature": "(request)", "bases": [], "class_attrs": {}, "raises": [], "uses": ["HttpResponseNotFound (django.http)", "TokenAuthentication (netbox.api.authentication)", "HttpResponseForbidden (django.http)"], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [{"source": "symbol:netbox/netbox/graphql/views.py:NetBoxGraphQLView:13"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
