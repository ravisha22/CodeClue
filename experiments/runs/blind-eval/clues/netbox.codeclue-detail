ure(self.object_type, 'notifications'):\n            raise ValidationError(\n                _(\"Objects of this type ({type}) do not support notifications.\").format(type=self.object_type)\n            )\n\n    def save(self, *args, **kwargs):\n        # Record a string representation of the associated object\n        if self.object:\n            self.object_repr = self.get_object_repr(self.object)\n\n        super().save(*args, **kwargs)\n\n    @cached_property\n    def event(self):\n        \"\"\"\n        Returns the registered Event which triggered this Notification.\n        \"\"\"\n        return registry['event_types'].get(self.event_type)\n\n    @classmethod\n    def get_object_repr(cls, obj):\n        return str(obj)[:200]", "calls": ["get_object_repr", "save"], "called_by": [], "confidence": 0.92, "purpose": "A notification message for a User relating to a specific object in NetBox.", "behavior_patterns": [], "semantic_contract": {"purpose": "A notification message for a User relating to a specific object in NetBox.", "language": "python", "symbol_name": "Notification", "symbol_type": "class", "signature": "", "bases": ["Model"], "class_attrs": {}, "raises": ["ValidationError"], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:netbox/extras/models/notifications.py:Notification.get_object_repr:117", "is_external": false}, {"target": "symbol:netbox/extras/models/notifications.py:Notification.save:102", "is_external": false}], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
