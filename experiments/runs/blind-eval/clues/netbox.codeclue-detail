 __str__(self):\n        if self.label:\n            return f\"{self.name} ({self.label})\"\n        return self.name\n\n    def to_objectchange(self, action):\n        objectchange = super().to_objectchange(action)\n        objectchange.related_object = self.device\n        return objectchange\n\n    def clean(self):\n        super().clean()\n\n        # Check list of Modules that allow device field to be changed\n        if (type(self) not in [InventoryItem]) and (self.pk is not None) and (self._original_device != self.device_id):\n            raise ValidationError({\n                \"device\": _(\"Components cannot be moved to a different device.\")\n            })\n\n    def save(self, *args, **kwargs):\n        # Save denormalized references\n        self._site = self.device.site\n        self._location = self.device.location\n        self._rack = self.device.rack\n\n        super().save(*args, **kwargs)\n\n    @property\n    def parent_object(self):\n        return self.device", "calls": ["__init__", "to_objectchange"], "called_by": [], "confidence": 0.92, "purpose": "An abstract model inherited by any model which has a parent Device.", "behavior_patterns": [], "semantic_contract": {"purpose": "An abstract model inherited by any model which has a parent Device.", "language": "python", "symbol_name": "ComponentModel", "symbol_type": "class", "signature": "", "bases": ["OwnerMixin", "NetBoxModel"], "class_attrs": {}, "raises": ["ValidationError"], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:netbox/dcim/models/device_components.py:ComponentModel.__init__:106", "is_external": false}, {"target": "symbol:netbox/dcim/models/device_components.py:ComponentModel.to_objectchange:117", "is_external": false}], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
