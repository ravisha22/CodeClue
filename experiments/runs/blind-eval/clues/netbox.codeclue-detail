{"node_id": "symbol:netbox/core/tests/test_models.py:JobTest.test_delete_cancels_job_from_correct_queue:230", "symbol": "test_delete_cancels_job_from_correct_queue", "type": "function", "file": "netbox/core/tests/test_models.py", "lines": [230, 259], "source": "    def test_delete_cancels_job_from_correct_queue(self, mock_get_queue):\n        \"\"\"\n        Test that when a job is deleted, it's canceled from the correct queue.\n        \"\"\"\n        mock_queue = MagicMock()\n        mock_rq_job = MagicMock()\n        mock_queue.fetch_job.return_value = mock_rq_job\n        mock_get_queue.return_value = mock_queue\n\n        def dummy_func(**kwargs):\n            pass\n\n        # Enqueue a job with a custom queue name\n        custom_queue = 'my_custom_queue'\n        job = Job.enqueue(\n            func=dummy_func,\n            name='Test Job',\n            queue_name=custom_queue\n        )\n\n        # Reset mock to clear enqueue call\n        mock_get_queue.reset_mock()\n\n        # Delete the job\n        job.delete()\n\n        # Verify the correct queue was used for cancellation\n        mock_get_queue.assert_called_with(custom_queue)\n        mock_queue.fetch_job.assert_called_with(str(job.job_id))\n        mock_rq_job.cancel.assert_called_once()", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "Test that when a job is deleted, it's canceled from the correct queue.", "behavior_patterns": [], "semantic_contract": {"purpose": "Test that when a job is deleted, it's canceled from the correct queue.", "language": "python", "symbol_name": "test_delete_cancels_job_from_correct_queue", "symbol_type": "function", "signature": "(mock_get_queue)", "bases": [], "class_attrs": {}, "raises": [], "uses": ["MagicMock (unittest.mock)"], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
{"node_id": "symbol:netbox/core/tests/test_models.py:JobTest:227", "symbol": "JobTest", "type": "class", "file": "netbox/core/tests/test_models.py", "lines": [227, 259], "source": "class JobTest(TestCase):\n\n    @patch('core.models.jobs.django_rq.get_queue')\n    def test_delete_cancels_job_from_correct_queue(self, mock_get_queue):\n        \"\"\"\n        Test that when a job is deleted, it's canceled from the correct queue.\n        \"\"\"\n        mock_queue = MagicMock()\n        mock_rq_job = MagicMock()\n        mock_queue.fetch_job.return_value = mock_rq_job\n        mock_get_queue.return_value = mock_queue\n\n        def dummy_func(**kwargs):\n            pass\n\n        # Enqueue a job with a custom queue name\n        custom_queue = 'my_custom_queue'\n        job = Job.enqueue(\n            func=dummy_func,\n            name='Test Job',\n            queue_name=custom_queue\n        )\n\n        # Reset mock to clear enqueue call\n        mock_get_queue.reset_mock()\n\n        # Delete the job\n        job.delete()\n\n        # Verify the correct queue was used for cancellation\n        mock_get_queue.assert_called_with(custom_queue)\n        mock_queue.fetch_job.assert_called_with(str(job.job_id))\n        mock_rq_job.cancel.assert_called_once()", "calls": [], "called_by": [], "confidence": 0.92, "purpose": "class JobTest", "behavior_patterns": [], "semantic_contract": {"purpose": "class JobTest", "language": "python", "symbol_name": "JobTest", "symbol_type": "class", "signature": "", "bases": ["TestCase"], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
