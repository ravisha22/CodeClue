{"node_id": "symbol:netbox/utilities/tracking.py:Tracker:6", "symbol": "Tracker", "type": "class", "file": "netbox/utilities/tracking.py", "lines": [6, 35], "source": "class Tracker:\n    \"\"\"\n    An ephemeral instance employed to record which tracked fields on an instance have been modified.\n    \"\"\"\n    def __init__(self):\n        self._changed_fields = {}\n\n    def __contains__(self, item):\n        return item in self._changed_fields\n\n    def set(self, name, value):\n        \"\"\"\n        Mark an attribute as having been changed and record its original value.\n        \"\"\"\n        self._changed_fields[name] = value\n\n    def get(self, name):\n        \"\"\"\n        Return the original value of a changed field. Raises KeyError if name is not found.\n        \"\"\"\n        return self._changed_fields[name]\n\n    def clear(self, *names):\n        \"\"\"\n        Clear any fields that were recorded as having been changed.\n        \"\"\"\n        for name in names:\n            self._changed_fields.pop(name, None)\n        else:\n            self._changed_fields = {}", "calls": [], "called_by": ["tracker", "TrackingModelMixin"], "confidence": 0.92, "purpose": "An ephemeral instance employed to record which tracked fields on an instance have been modified.", "behavior_patterns": [], "semantic_contract": {"purpose": "An ephemeral instance employed to record which tracked fields on an instance have been modified.", "language": "python", "symbol_name": "Tracker", "symbol_type": "class", "signature": "", "bases": [], "class_attrs": {}, "raises": [], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [], "called_by": [{"source": "symbol:netbox/utilities/tracking.py:TrackingModelMixin.tracker:47"}, {"source": "symbol:netbox/utilities/tracking.py:TrackingModelMixin:38"}], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
