has_more = self._get_items(obj)\n\n        return {\n            'linkify': self.linkify,\n            'colored': self.colored,\n            'items': [\n                {\n                    'value': item,\n                    'group': getattr(item, self.grouped_by, None) if self.grouped_by else None,\n                }\n                for item in items\n            ],\n            'overflow_indicator': self.overflow_indicator if has_more else None,\n        }\n\n    def render(self, obj, context):\n        context = context or {}\n        context_data = self.get_context(obj, context)\n\n        if not context_data['items']:\n            return self.placeholder\n\n        return render_to_string(self.template_name, {\n            'name': context.get('name'),\n            **context_data,\n        })\n\n", "calls": ["_get_items"], "called_by": [], "confidence": 0.92, "purpose": "An attribute representing a list of related objects.", "behavior_patterns": [], "semantic_contract": {"purpose": "An attribute representing a list of related objects.", "language": "python", "symbol_name": "RelatedObjectListAttr", "symbol_type": "class", "signature": "", "bases": ["RelatedObjectAttr"], "class_attrs": {"template_name": "'ui/attrs/object_list.html'"}, "raises": ["ValueError"], "uses": [], "behavior_patterns": [], "tier": 1, "calls": [{"target": "symbol:netbox/netbox/ui/attrs.py:RelatedObjectListAttr._get_items:306", "is_external": false}], "called_by": [], "complexity_indicators": {"decorator_depth": 0, "generic_type_param_count": 0}}}
