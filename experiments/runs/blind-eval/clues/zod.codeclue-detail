{"symbol": "isValidBase64URL", "type": "function", "file": "packages/zod/src/v4/core/schemas.ts", "lines": [930, 935], "source": "export function isValidBase64URL(data: string): boolean {\n  if (!regexes.base64url.test(data)) return false;\n  const base64 = data.replace(/[-_]/g, (c) => (c === \"-\" ? \"+\" : \"/\"));\n  const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, \"=\");\n  return isValidBase64(padded);\n}", "calls": ["isValidBase64"], "called_by": [], "confidence": 0.86, "purpose": "function isValidBase64URL"}
{"symbol": "isValidJWT", "type": "function", "file": "packages/zod/src/v4/core/schemas.ts", "lines": [982, 997], "source": "export function isValidJWT(token: string, algorithm: util.JWTAlgorithm | null = null): boolean {\n  try {\n    const tokensParts = token.split(\".\");\n    if (tokensParts.length !== 3) return false;\n    const [header] = tokensParts;\n    if (!header) return false;\n    // @ts-ignore\n    const parsedHeader = JSON.parse(atob(header));\n    if (\"typ\" in parsedHeader && parsedHeader?.typ !== \"JWT\") return false;\n    if (!parsedHeader.alg) return false;\n    if (algorithm && (!(\"alg\" in parsedHeader) || parsedHeader.alg !== algorithm)) return false;\n    return true;\n  } catch {\n    return false;\n  }\n}", "calls": ["_.parse"], "called_by": [], "confidence": 0.86, "purpose": "function isValidJWT"}
