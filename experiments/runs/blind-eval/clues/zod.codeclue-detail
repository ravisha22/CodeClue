\n  get items() {\n    return this._def.items;\n  }\n\n  rest<RestSchema extends ZodTypeAny>(rest: RestSchema): ZodTuple<T, RestSchema> {\n    return new ZodTuple({\n      ...this._def,\n      rest,\n    });\n  }\n\n  static create = <Items extends [ZodTypeAny, ...ZodTypeAny[]] | []>(\n    schemas: Items,\n    params?: RawCreateParams\n  ): ZodTuple<Items, null> => {\n    if (!Array.isArray(schemas)) {\n      throw new Error(\"You must pass an array of schemas to z.tuple([ ... ])\");\n    }\n    return new ZodTuple({\n      items: schemas,\n      typeName: ZodFirstPartyTypeKind.ZodTuple,\n      rest: null,\n      ...processCreateParams(params),\n    });\n  };\n}\n\n/////////////////////////////////////////", "calls": ["ParseInputLazyPath", "ZodAny._parse", "ZodAny._parse", "ZodArray._parse", "ZodArray._parse", "ZodBigInt._parse", "ZodBigInt._parse", "ZodBoolean._parse", "ZodBoolean._parse", "ZodBranded._parse", "ZodBranded._parse", "ZodCatch._parse", "ZodCatch._parse", "ZodDate._parse", "ZodDate._parse", "ZodDefault._parse", "ZodDefault._parse", "ZodEffects._parse", "ZodEffects._parse", "ZodEnum._parse", "ZodEnum._parse", "ZodFunction._parse", "ZodFunction._parse", "ZodIntersection._parse", "ZodIntersection._parse", "ZodLazy._parse", "ZodLazy._parse", "ZodLiteral._parse", "ZodLiteral._parse", "ZodMap._parse", "ZodMap._parse", "ZodNaN._parse", "ZodNaN._parse", "ZodNativeEnum._parse", "ZodNativeEnum._parse", "ZodNever._parse", "ZodNever._parse", "ZodNull._parse", "ZodNull._parse", "ZodNullable._parse", "ZodNullable._parse", "ZodNumber._parse", "ZodNumber._parse", "ZodOptional._parse", "ZodOptional._parse", "ZodPipeline._parse", "ZodPipeline._parse", "ZodPromise._parse", "ZodPromise._parse", "ZodReadonly._parse", "ZodReadonly._parse", "ZodRecord._parse", "ZodRecord._parse", "ZodSet._parse", "ZodSet._parse", "ZodString._parse", "ZodString._parse", "ZodSymbol._parse", "ZodSymbol._parse", "ZodTuple._parse", "ZodTuple._parse", "ZodTuple.items", "ZodType._parse", "ZodType._