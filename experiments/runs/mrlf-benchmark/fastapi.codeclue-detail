ge = \"👥 Update FastAPI People - Sponsors\"\n    subprocess.run([\"git\", \"commit\", \"-m\", message], check=True)\n    logging.info(\"Pushing branch\")\n    subprocess.run([\"git\", \"push\", \"origin\", branch_name], check=True)\n    logging.info(\"Creating PR\")\n    pr = repo.create_pull(title=message, body=message, base=\"master\", head=branch_name)\n    logging.info(f\"Created PR: {pr.number}\")\n    logging.info(\"Finished\")\n\n\nif __name__ == \"__main__\":","calls":["Settings","get_individual_sponsors","update_content"],"called_by":[],"confidence":0.92,"purpose":"function main"}
{"symbol":"update_content","type":"function","file":"scripts/sponsors.py","lines":[147,156],"source":"def update_content(*, content_path: Path, new_content: Any) -> bool:\n    old_content = content_path.read_text(encoding=\"utf-8\")\n\n    new_content = yaml.dump(new_content, sort_keys=False, width=200, allow_unicode=True)\n    if old_content == new_content:\n        logging.info(f\"The content hasn't changed for {content_path}\")\n        return False\n    content_path.write_text(new_content, encoding=\"utf-8\")\n    logging.info(f\"Updated {content_path}\")\n    return True","calls":[],"called_by":["main"],"confidence":0.92,"purpose":"function update_content"}
